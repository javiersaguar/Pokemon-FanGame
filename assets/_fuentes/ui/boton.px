# Botones de combate (9-slice: márgenes de 4). Borde oscuro de 1 px y relieve:
# luz en el borde de arriba y la izquierda, sombra de 2 px abajo.
# b = borde, l = luz, m = color, s = sombra.
@leyenda  . = transparente   b = ui_1   l = teja_5   m = acento_rojo   s = teja_2
@salida res://assets/sprites/ui/battle/button_rojo.png
@salida res://assets/sprites/ui/battle/button_rojo_foco.png  b=ui_6
@salida res://assets/sprites/ui/battle/button_rojo_foco2.png  b=tierra_6
@salida res://assets/sprites/ui/battle/button_amarillo.png  l=tierra_6  m=acento_amarillo  s=madera_3
@salida res://assets/sprites/ui/battle/button_amarillo_foco.png  b=ui_6  l=tierra_6  m=acento_amarillo  s=madera_3
@salida res://assets/sprites/ui/battle/button_amarillo_foco2.png  b=tierra_6  l=tierra_6  m=acento_amarillo  s=madera_3
@salida res://assets/sprites/ui/battle/button_verde.png  l=hierba_5  m=acento_verde  s=hierba_2
@salida res://assets/sprites/ui/battle/button_verde_foco.png  b=ui_6  l=hierba_5  m=acento_verde  s=hierba_2
@salida res://assets/sprites/ui/battle/button_verde_foco2.png  b=tierra_6  l=hierba_5  m=acento_verde  s=hierba_2
@salida res://assets/sprites/ui/battle/button_azul.png  l=pizarra_5  m=acento_azul  s=pizarra_2
@salida res://assets/sprites/ui/battle/button_azul_foco.png  b=ui_6  l=pizarra_5  m=acento_azul  s=pizarra_2
@salida res://assets/sprites/ui/battle/button_azul_foco2.png  b=tierra_6  l=pizarra_5  m=acento_azul  s=pizarra_2
@salida res://assets/sprites/ui/battle/button_claro.png  l=ui_6  m=ui_5  s=ui_3
@salida res://assets/sprites/ui/battle/button_claro_foco.png  b=acento_amarillo  l=ui_6  m=ui_5  s=ui_3
@salida res://assets/sprites/ui/battle/button_claro_foco2.png  b=madera_4  l=ui_6  m=ui_5  s=ui_3
@salida res://assets/sprites/ui/battle/button_gris.png  l=piedra_5  m=piedra_4  s=piedra_2
