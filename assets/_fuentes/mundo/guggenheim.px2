# Guggenheim Bilbao con el Puppy de flores a la izquierda de la puerta.
# Curva de titanio. 192x128 del arte (12x8), a x2.
# PROVISIONAL hasta que lo apruebe Javier.
@leyenda  . = transparente   K = piedra_1   D = piedra_2   d = piedra_3   s = piedra_4   S = piedra_5   L = piedra_6
@leyenda  n = metal_2   N = metal_3   m = metal_4   M = metal_5   T = metal_6   u = ui_5   U = ui_6
@leyenda  w = madera_2   W = madera_4   R = teja_2   r = teja_4   e = acento_rojo   y = acento_amarillo   g = acento_verde
@leyenda  v = hierba_2   V = hierba_4   h = hierba_5   a = agua_4   A = agua_5   p = pizarra_3   P = pizarra_5
@salida res://assets/tilesets/exterior/hecho_a_mano/guggenheim.png
