        32,
        32
      ]
    },
    {
      "path": "res://assets/sprites/characters/objects.png",
      "frame": [
        32,
        32
      ]
    },
    {
      "path": "res://assets/sprites/ui/battle/transitions/wild.png",
      "size": [
        512,
