    "res://assets/_fuentes/",
    "res://assets/arte/",
    "res://assets/fonts/"
  ],
  "third_party": [
    "res://assets/sprites/characters/",
    "res://assets/sprites/trainers/",
    "res://assets/sprites/pokemon/",
    "res://assets/sprites/items/",
    "res://assets/sprites/ui/battle/backgrounds/",
    "res://assets/sprites/ui/battle/shadows/",
