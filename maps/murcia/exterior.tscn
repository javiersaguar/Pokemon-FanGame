position = Vector2(400, 880)
script = ExtResource("11_8pcsm")
lines = PackedStringArray("¡Pastel de carne! Hojaldre por arriba, ternera, huevo y chorizo por dentro. Se come con las manos y sin testigos.", "Y una marinera: rosquilla, ensaladilla y anchoa. Si le quitas la anchoa es una bicicleta. No preguntes.")
