[node name="Acalorado" type="Node2D" parent="Entities" unique_id=1846622356 instance=ExtResource("10_d8xg7")]
position = Vector2(1168, 1072)
script = ExtResource("11_8pcsm")
lines = PackedStringArray("Estoy bien, zagal. Solo me he sentado a la sombra de la torre. En mayo. Vuelvo a casa en octubre.")
