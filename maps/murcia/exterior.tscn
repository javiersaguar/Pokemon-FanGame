lines = PackedStringArray("TERMÓMETRO DE LA GRAN VÍA: 45 °C.", "Lleva marcando lo mismo desde 2019. No está roto.")
show_sprite = false

[node name="CartelRomea" type="Node2D" parent="Entities" unique_id=287514362 instance=ExtResource("5_vdtk4")]
position = Vector2(528, 432)
script = ExtResource("6_8x67b")
lines = PackedStringArray("TEATRO ROMEA.", "Dice la leyenda que arderá tres veces. Lleva dos. La tercera función se agota siempre por si acaso.")
show_sprite = false

[node name="CartelUniversidad" type="Node2D" parent="Entities" unique_id=345385460 instance=ExtResource("5_vdtk4")]
position = Vector2(880, 432)
script = ExtResource("6_8x67b")
lines = PackedStringArray("UNIVERSIDAD DE MURCIA.", "Prácticas no remuneradas en toda la huerta. Se valora inglés y tractor.")
show_sprite = false

[node name="CartelCasino" type="Node2D" parent="Entities" unique_id=1114019302 instance=ExtResource("5_vdtk4")]
position = Vector2(944, 880)
script = ExtResource("6_8x67b")
lines = PackedStringArray("REAL CASINO DE MURCIA.", "Salón de baile, patio árabe y un tocador de señoras con el techo pintado. Aquí no se apuesta: se aparenta.")
show_sprite = false

[node name="CartelCatedral" type="Node2D" parent="Entities" unique_id=1146341442 instance=ExtResource("5_vdtk4")]
position = Vector2(1072, 1008)
script = ExtResource("6_8x67b")
lines = PackedStringArray("CATEDRAL DE MURCIA.", "La torre mide 93 metros y tardó más de dos siglos. Se nota: cada cuerpo es de un estilo, según quién mandara.")
show_sprite = false

[node name="CartelMoneo" type="Node2D" parent="Entities" unique_id=1436581296 instance=ExtResource("5_vdtk4")]
position = Vector2(1680, 1168)
script = ExtResource("6_8x67b")
lines = PackedStringArray("ANEXO DEL AYUNTAMIENTO (Moneo, 1998).", "Un edificio moderno delante de la catedral barroca. La mitad de Murcia aún no se habla con la otra mitad.")
show_sprite = false

[node name="CartelSardina" type="Node2D" parent="Entities" unique_id=1202543411 instance=ExtResource("5_vdtk4")]
position = Vector2(1104, 1200)
script = ExtResource("6_8x67b")
lines = PackedStringArray("RÍO SEGURA · LA SARDINA.", "En las Fiestas de Primavera se entierra la sardina. Quemándola. En Murcia las cosas se hacen así.")
show_sprite = false

