[node name="ObreroDeLaSagradaFamilia" type="Node2D" parent="Entities" unique_id=966650718 instance=ExtResource("5_wmeql")]
position = Vector2(80, 240)
script = ExtResource("6_rmdhd")
display_name = "Obrero de la Sagrada Familia"
lines = PackedStringArray("Mi bisabuelo trabajó en esta obra, y mi abuelo, y mi padre. Mi hijo dice que él la terminará. Lo dudo.", "Me preguntan cuándo se acaba. Les digo que el año que viene. Lo dice la empresa desde 1882.")
turn_to_player = true
sprite_sheet = ExtResource("7_ivv0w")
initial_facing = 2

[node name="MonjaGuia" type="Node2D" parent="Entities" unique_id=514077528 instance=ExtResource("5_wmeql")]
position = Vector2(272, 80)
script = ExtResource("6_rmdhd")
display_name = "Monja guía"
lines = PackedStringArray("Las columnas son árboles y la luz es el bosque. Gaudí decía que su cliente, Dios, no tenía prisa.", "El que no tiene prisa es Dios. Los de la cola para entrar, sí.")
turn_to_player = true
sprite_sheet = ExtResource("8_4bckb")

[node name="TuristaEmocionada" type="Node2D" parent="Entities" unique_id=447776925 instance=ExtResource("5_wmeql")]
position = Vector2(144, 240)
script = ExtResource("6_rmdhd")
display_name = "Turista emocionada"
lines = PackedStringArray("He llorado al entrar. Bueno, también he llorado al pagar la entrada.", "La luz de las vidrieras es de colores. Me he hecho cuatrocientas fotos y en todas salgo azul.")
turn_to_player = true
sprite_sheet = ExtResource("9_wap35")
initial_facing = 3

