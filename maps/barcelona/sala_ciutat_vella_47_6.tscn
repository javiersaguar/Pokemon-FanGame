script = ExtResource("6_8upka")
display_name = "Nieto de la vecina"
lines = PackedStringArray("Me empadroné aquí para heredar el contrato de renta antigua. Es el único tesoro de la familia.", "Mis amigos viven en Sabadell. Yo vivo en el Born con mi abuela. Ellos me envidian; yo envidio su ascensor.")
