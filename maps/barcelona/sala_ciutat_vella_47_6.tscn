[node name="VecinaDelBorn" type="Node2D" parent="Entities" unique_id=1803715958 instance=ExtResource("5_38mie")]
position = Vector2(272, 112)
script = ExtResource("6_8upka")
display_name = "Vecina del Born"
lines = PackedStringArray("En mi escalera había doce vecinos. Ahora hay once pisos turísticos y yo, que soy la atracción.", "Los turistas me preguntan si soy un museo. Les cobro dos euros y les cuento cómo era el barrio.")
