script = ExtResource("6_xbt57")
display_name = "Abuela del barrio"
lines = PackedStringArray("Vengo a comprar como hace cincuenta años. Tardo una hora en cruzar entre los turistas, pero no me rindo.", "Me han hecho una foto escogiendo tomates. Dicen que soy «auténtica». Lo que soy es vieja.")
