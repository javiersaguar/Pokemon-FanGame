[node name="VendedoraDeZumos" type="Node2D" parent="Entities" unique_id=1629471956 instance=ExtResource("5_g1egq")]
position = Vector2(144, 208)
script = ExtResource("6_xbt57")
display_name = "Vendedora de zumos"
lines = PackedStringArray("Zumo de mango, de pitaya y de fruta del dragón. Ningún barcelonés compra aquí, pero todos hacen la foto.", "El vaso de zumo cuesta cinco euros. La pajita de papel se deshace gratis.")
