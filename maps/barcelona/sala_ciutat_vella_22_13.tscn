[node name="Pescadero" type="Node2D" parent="Entities" unique_id=974984499 instance=ExtResource("5_g1egq")]
position = Vector2(208, 80)
script = ExtResource("6_xbt57")
display_name = "Pescadero"
lines = PackedStringArray("Antes vendía merluza a las señoras del barrio. Ahora vendo cucuruchos de calamares a gente en chanclas.", "Si me preguntan si el pescado es fresco, digo que más fresco que el que pregunta.")
turn_to_player = true
sprite_sheet = ExtResource("8_70n0m")

