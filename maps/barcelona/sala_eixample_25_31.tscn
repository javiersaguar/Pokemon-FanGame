display_name = "Taquillera de la Casa Batlló"
lines = PackedStringArray("La entrada normal son treinta y cinco euros. La de «experiencia inmersiva» son cincuenta: es lo mismo con gafas.", "La fachada son huesos y escamas. Los vecinos la llaman «la casa de los huesos». Los turistas, «la de Instagram».")
