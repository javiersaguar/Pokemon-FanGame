script = ExtResource("6_t811n")
display_name = "Niño fascinado"
lines = PackedStringArray("El tejado es un dragón y la torre es la espada de Sant Jordi que lo mata. Esto es mejor que cualquier videojuego.", "Le he preguntado a mi padre si podemos vivir aquí. Me ha dicho que con suerte en la acera de enfrente.")
