display_name = "Àvia Montserrat"
lines = PackedStringArray("Hago escudella de domingo para toda la familia. La familia viene por la escudella, no por mí. Lo tengo asumido.", "Cuando yo era joven, el Raval se llamaba Barrio Chino. Ahora es «zona trendy». Los bares siguen siendo los mismos.")
