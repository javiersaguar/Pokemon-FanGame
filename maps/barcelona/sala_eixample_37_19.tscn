[node name="GuiaDeLaPedrera" type="Node2D" parent="Entities" unique_id=1211707871 instance=ExtResource("5_8xcnq")]
position = Vector2(208, 176)
script = ExtResource("6_k56m6")
display_name = "Guía de La Pedrera"
lines = PackedStringArray("Gaudí no puso ni una pared recta. Los fontaneros todavía lloran cuando tienen que entrar.", "En la azotea hay chimeneas con forma de soldado. Dicen que inspiraron una película de galaxias; Gaudí no cobró derechos.")
