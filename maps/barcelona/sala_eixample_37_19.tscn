[node name="TuristaConAudioguia" type="Node2D" parent="Entities" unique_id=912341071 instance=ExtResource("5_8xcnq")]
position = Vector2(272, 176)
script = ExtResource("6_k56m6")
display_name = "Turista con audioguía"
lines = PackedStringArray("La audioguía habla en catorce idiomas. Ninguno explica por qué la entrada cuesta treinta euros.", "Me he mareado mirando el techo. Me dicen que es normal, que así lo quería Gaudí.")
turn_to_player = true
sprite_sheet = ExtResource("8_ws2ch")

