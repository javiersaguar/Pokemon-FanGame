[node name="Parroco" type="Node2D" parent="Entities" unique_id=382294852 instance=ExtResource("5_bykw3")]
position = Vector2(176, 80)
script = ExtResource("6_rrnjj")
display_name = "Párroco"
lines = PackedStringArray("Esta catedral está dedicada a la Virgen de las Nieves. En Ibiza, en agosto. Que la fe mueve montañas, pero no el termómetro.", "Los domingos tengo misa a las doce. A esa hora la mitad de la isla aún no se ha acostado.")
