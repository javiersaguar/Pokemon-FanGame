sprite_sheet = ExtResource("7_qo8ph")

[node name="TuristaEnChanclas" type="Node2D" parent="Entities" unique_id=981090864 instance=ExtResource("5_bykw3")]
position = Vector2(112, 240)
script = ExtResource("6_rrnjj")
display_name = "Turista en chanclas"
lines = PackedStringArray("He subido toda la muralla en chanclas. Esto es más duro que la cola del club.", "¿Aquí también hay que pagar entrada? Ah, que es la voluntad. ¿Y cuánto suele ser la voluntad?")
turn_to_player = true
sprite_sheet = ExtResource("8_6yk2b")
initial_facing = 3

