script = ExtResource("6_rrnjj")
display_name = "Feligresa"
lines = PackedStringArray("Rezo cada día para que mi nieto encuentre piso en la isla. Lo de los milagros va lento.", "El cura dice que en el cielo hay sitio para todos. Espero que no lo compre un fondo.")
