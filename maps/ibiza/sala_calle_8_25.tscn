[node name="Nerea" type="Node2D" parent="Entities" unique_id=1903739897 instance=ExtResource("5_rajlb")]
position = Vector2(112, 144)
script = ExtResource("6_wf6ds")
display_name = "Nerea"
lines = PackedStringArray("Oposito a policía local de Ibiza. Si apruebo, me podré pagar el alquiler de esta casa. Si no, el de un balcón.", "El temario tiene tres mil páginas. Ninguna explica cómo vivir aquí con un sueldo público.")
turn_to_player = true
sprite_sheet = ExtResource("7_ecalx")

[node name="Casera" type="Node2D" parent="Entities" unique_id=624047641 instance=ExtResource("5_rajlb")]
position = Vector2(48, 240)
script = ExtResource("6_wf6ds")
display_name = "Casera"
lines = PackedStringArray("A la chica le cobro poco, 1.300. Es que me da pena: es funcionaria en prácticas de la esperanza.", "En agosto la saco una semana y alquilo su cuarto a unos noruegos. Ella lo entiende: es temporada.")
turn_to_player = true
sprite_sheet = ExtResource("8_5746l")
initial_facing = 1

