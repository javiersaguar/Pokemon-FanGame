script = ExtResource("6_84u8q")
display_name = "Abuelo Ribas"
lines = PackedStringArray("Cuando yo era niño, aquí no había discotecas. Había una sola y era la iglesia los domingos.", "Los de fuera vienen a ver la isla de verdad. La de verdad la tengo yo en una caja de fotos.")
