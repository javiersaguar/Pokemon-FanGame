script = ExtResource("6_84u8q")
display_name = "Nuera"
lines = PackedStringArray("Mi marido trabaja en el aeropuerto. Ve llegar a todo el mundo y no ve salir a nadie con casa.", "Aquí comemos flaó de postre. Queso y hierbabuena: lo único de la isla que aún no cotiza en bolsa.")
