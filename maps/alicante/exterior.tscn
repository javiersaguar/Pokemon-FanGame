[node name="Foguerer" type="Node2D" parent="Entities" unique_id=1064353786 instance=ExtResource("10_aoq5c")]
position = Vector2(592, 720)
script = ExtResource("11_07kbs")
lines = PackedStringArray("En junio plantamos las Hogueras y la noche de San Juan las quemamos.", "Los de Valencia dicen que les copiamos las Fallas. Ellos queman en marzo, con abrigo: eso no es quemar ni es nada.")
turn_to_player = true
sprite_sheet = ExtResource("12_umdg3")

[node name="Abuelo" type="Node2D" parent="Entities" unique_id=668617025 instance=ExtResource("10_aoq5c")]
position = Vector2(1072, 1424)
script = ExtResource("11_07kbs")
lines = PackedStringArray("Me siento aquí cada tarde a ver pasar cruceristas. Bajan tres mil, compran un imán y se vuelven al barco.")
turn_to_player = true
sprite_sheet = ExtResource("13_f1gm7")

[node name="Guia" type="Node2D" parent="Entities" unique_id=518179770 instance=ExtResource("10_aoq5c")]
position = Vector2(1936, 464)
script = ExtResource("11_07kbs")
lines = PackedStringArray("Desde la playa, la montaña tiene cara: la Cara del Moro. Desde aquí arriba solo se ven hoteles.", "El castillo aguantó a franceses, ingleses y piratas. Con los pisos turísticos ya veremos.")
turn_to_player = true
sprite_sheet = ExtResource("14_bus4d")

[node name="Tendera" type="Node2D" parent="Entities" unique_id=735656346 instance=ExtResource("10_aoq5c")]
position = Vector2(1136, 464)
script = ExtResource("11_07kbs")
lines = PackedStringArray("¡Turrón de Jijona y de Alicante! El blando y el duro. El que rompe muelas es el de Alicante, que conste.")
turn_to_player = true
sprite_sheet = ExtResource("14_bus4d")
initial_facing = 1

[node name="Crucerista" type="Node2D" parent="Entities" unique_id=237846001 instance=ExtResource("10_aoq5c")]
position = Vector2(1488, 1456)
script = ExtResource("11_07kbs")
lines = PackedStringArray("Tengo cuatro horas de escala. Ya he visto el castillo desde abajo y me he comprado un imán. ¿Me falta algo?")
turn_to_player = true
sprite_sheet = ExtResource("15_qqwno")

[node name="Vecina" type="Node2D" parent="Entities" unique_id=1652874910 instance=ExtResource("10_aoq5c")]
position = Vector2(1712, 912)
script = ExtResource("11_07kbs")
lines = PackedStringArray("En Santa Cruz quedamos cuatro vecinas y cuarenta pisos turísticos. Las macetas las riego yo todas.")
turn_to_player = true
sprite_sheet = ExtResource("16_kw6mb")

