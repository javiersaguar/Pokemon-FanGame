lines = PackedStringArray("GRANDES ALMACENES.", "Ya es primavera. Desde enero.")
show_sprite = false

[node name="CartelClub" type="Node2D" parent="Entities" unique_id=775753760 instance=ExtResource("5_h75yo")]
position = Vector2(336, 688)
script = ExtResource("6_yb71g")
lines = PackedStringArray("CLUB DE ARTES MARCIALES.", "De aquí salió un campeón del mundo. Lo dice él mismo en cuanto entras, por si no lo sabías.")
show_sprite = false

[node name="CartelLuceros" type="Node2D" parent="Entities" unique_id=1243377701 instance=ExtResource("5_h75yo")]
position = Vector2(624, 624)
script = ExtResource("6_yb71g")
lines = PackedStringArray("PLAZA DE LOS LUCEROS.", "Aquí se dispara la mascletà de las Hogueras. La fuente lleva un siglo aguantando la respiración.")
show_sprite = false

[node name="CartelConcatedral" type="Node2D" parent="Entities" unique_id=931912362 instance=ExtResource("5_h75yo")]
position = Vector2(1040, 1104)
script = ExtResource("6_yb71g")
lines = PackedStringArray("CONCATEDRAL DE SAN NICOLÁS (1662).", "La cúpula azul mide 45 metros. Debajo hubo una mezquita; debajo de la mezquita, seguramente un bar.")
show_sprite = false

[node name="CartelCarbonell" type="Node2D" parent="Entities" unique_id=1942165906 instance=ExtResource("5_h75yo")]
position = Vector2(784, 1424)
script = ExtResource("6_yb71g")
lines = PackedStringArray("CASA CARBONELL (1925).", "Cuentan que al dueño, un fabricante de tejidos, no le dejaron entrar en el hotel de al lado por las pintas. Se hizo este, más grande, pegado.")
show_sprite = false

[node name="CartelExplanada" type="Node2D" parent="Entities" unique_id=941342767 instance=ExtResource("5_h75yo")]
position = Vector2(1168, 1424)
script = ExtResource("6_yb71g")
lines = PackedStringArray("EXPLANADA DE ESPAÑA.", "Seis millones y medio de teselas. Si miras fijo las ondas, te mareas gratis.")
show_sprite = false

[node name="CartelCastillo" type="Node2D" parent="Entities" unique_id=544299972 instance=ExtResource("5_h75yo")]
position = Vector2(1680, 656)
script = ExtResource("6_yb71g")
lines = PackedStringArray("↑ CASTILLO DE SANTA BÁRBARA.", "Ascensor por dentro de la montaña: averiado. Suba por la cuesta, que es más auténtico.")
show_sprite = false

