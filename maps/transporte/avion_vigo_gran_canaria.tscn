event_params = {
"hablante": "Comandante",
"llegada": ["Iniciamos el descenso a Gran Canaria. En tierra, veinticuatro grados y sol. Como siempre."],
"marca": "vuelo_libre",
"salida": ["Buenos días, les habla el comandante. Bienvenidos a bordo del vuelo a Gran Canaria. Duración: unas dos horas y media.", "Pueden quitarse el abrigo. Y el jersey. Y lo que quieran, que vamos a Maspalomas."],
"trayecto": ["El avión atraviesa unas turbulencias sobre el Atlántico. Una señora reza en gallego."],
