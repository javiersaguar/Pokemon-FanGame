event_params = {
"hablante": "Megafonía",
"llegada": ["Llegamos a Málaga María Zambrano con cincuenta minutos de retraso por un robo de cable.", "El ministro ha dicho que no es culpa suya. Esta vez, a lo mejor, es verdad."],
"salida": ["Renfe les da la bienvenida a bordo del AVE con destino Málaga María Zambrano. Duración: dos horas y cuarenta minutos.", "El vagón cafetería está al fondo. El café cuesta lo mismo que el abono de Cercanías de un mes."],
"trayecto": ["Despeñaperros pasa por la ventana en un suspiro. Después, olivos. Después, más olivos. Después, ya ni los cuentas."]
}
