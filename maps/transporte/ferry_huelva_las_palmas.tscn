event = ExtResource("trigger_event")
event_params = {
"billete": "ssticket",
"hablante": "Megafonía",
"llegada": ["Señores pasajeros, estamos entrando en el puerto de La Luz, en Las Palmas. ¡Bienvenidos a Gran Canaria, mi niño!"],
"precio": 300,
"salida": ["Bienvenidos a bordo del ferry a Las Palmas de Gran Canaria. Duración de la travesía: más de un día.", "Sí, más de un día. Esto es el Atlántico, no el Retiro. El bar abre por turnos; las películas, también."],
"trayecto": ["Pasa un día entero. Has visto tres veces la misma película, dos delfines y un camionero que no ha dejado de hablar de Canarias."],
"vuelta": ["huelva/exterior", "from_ferry"]
}
mode = 1
