[node name="Camarero" type="Node2D" parent="Entities" unique_id=1201125507 instance=ExtResource("5_r8e6m")]
position = Vector2(144, 112)
script = ExtResource("6_81x14")
lines = PackedStringArray("¿Un café? Cuatro euros. Es que estamos en alta mar. Bueno, a la salida del puerto, pero cuenta.", "Bocadillo de tortilla, nueve euros. Sin tortilla, siete. Es pan con aceite, pero aquí lo llamamos «mediterráneo».")
turn_to_player = true
sprite_sheet = ExtResource("7_yty1m")

[node name="Sobrecargo" type="Node2D" parent="Entities" unique_id=1520615577 instance=ExtResource("5_r8e6m")]
position = Vector2(336, 336)
script = ExtResource("6_81x14")
lines = PackedStringArray("Por la puerta de abajo se baja al puerto. Cuando lleguemos, claro: nadar no te dejo.", "Si te mareas, mira al horizonte. Si no hay horizonte, mira al bar.")
turn_to_player = true
sprite_sheet = ExtResource("8_kp356")
initial_facing = 1

[node name="Camionero" type="Node2D" parent="Entities" unique_id=228159967 instance=ExtResource("5_r8e6m")]
position = Vector2(400, 208)
script = ExtResource("6_81x14")
lines = PackedStringArray("Hago este viaje cada semana con el camión. Es más barato que el avión. Y tengo más tiempo para contarte mi vida.")
turn_to_player = true
sprite_sheet = ExtResource("9_cbeqs")
initial_facing = 1

[node name="Canaria" type="Node2D" parent="Entities" unique_id=968983957 instance=ExtResource("5_r8e6m")]
position = Vector2(112, 272)
script = ExtResource("6_81x14")
lines = PackedStringArray("Vuelvo a casa. En la península nos llaman a todos «canarios». Y en Gran Canaria, a los de Tenerife, otra cosa.")
turn_to_player = true
sprite_sheet = ExtResource("10_vbtsx")
initial_facing = 2

[node name="Ornitologa" type="Node2D" parent="Entities" unique_id=1714466489 instance=ExtResource("5_r8e6m")]
position = Vector2(432, 304)
script = ExtResource("6_81x14")
lines = PackedStringArray("He visto dos delfines y un Wingull mareado. Lo apunto todo en mi libreta.")
turn_to_player = true
sprite_sheet = ExtResource("11_vk6yx")
initial_facing = 3

