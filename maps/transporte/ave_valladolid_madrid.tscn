event_params = {
"hablante": "Megafonía",
"llegada": ["Llegamos a Madrid con treinta y cinco minutos de retraso. Les recordamos que tienen derecho a una compensación.", "Rellenen el formulario. En papel. En la estación. En horario de oficina."],
"salida": ["Renfe les da la bienvenida a bordo del AVE con destino Madrid. Llegada prevista en una hora.", "Por obras en el túnel de Guadarrama, puede haber pequeñas incidencias. Grandes, también."],
"trayecto": ["El tren espera media hora en la boca del túnel. Alguien abre una bolsa de pipas. Nadie se queja: es tradición."]
}
