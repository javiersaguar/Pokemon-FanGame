[node name="Camarero" type="Node2D" parent="Entities" unique_id=1927328535 instance=ExtResource("5_icuf0")]
position = Vector2(144, 112)
script = ExtResource("6_rdy8e")
lines = PackedStringArray("¿Un café? Cuatro euros. Es que estamos en alta mar. Bueno, a la salida del puerto, pero cuenta.", "Bocadillo de tortilla, nueve euros. Sin tortilla, siete. Es pan con aceite, pero aquí lo llamamos «mediterráneo».")
turn_to_player = true
sprite_sheet = ExtResource("7_lycud")

[node name="Sobrecargo" type="Node2D" parent="Entities" unique_id=139175092 instance=ExtResource("5_icuf0")]
position = Vector2(336, 336)
script = ExtResource("6_rdy8e")
lines = PackedStringArray("Por la puerta de abajo se baja al puerto. Cuando lleguemos, claro: nadar no te dejo.", "Si te mareas, mira al horizonte. Si no hay horizonte, mira al bar.")
turn_to_player = true
sprite_sheet = ExtResource("8_iejtn")
initial_facing = 1

[node name="Mus" type="Node2D" parent="Entities" unique_id=1415116538 instance=ExtResource("5_icuf0")]
position = Vector2(400, 208)
script = ExtResource("6_rdy8e")
lines = PackedStringArray("¿Juegas al mus? Me falta pareja desde Las Palmas. La última se mareó en el primer órdago.")
turn_to_player = true
sprite_sheet = ExtResource("9_eyfx3")
initial_facing = 1

[node name="Estudiante" type="Node2D" parent="Entities" unique_id=285736092 instance=ExtResource("5_icuf0")]
