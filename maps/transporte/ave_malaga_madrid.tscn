event_params = {
"hablante": "Megafonía",
"llegada": ["Llegamos a Madrid Puerta de Atocha con una hora de retraso. ¡Gracias por elegir Renfe! Bueno, tampoco había otra cosa."],
"salida": ["Renfe les da la bienvenida a bordo del AVE con destino Madrid Puerta de Atocha. Duración: dos horas y cuarenta minutos.", "Les rogamos que no suban el volumen del móvil. Ni del altavoz. Ni de la guitarra."],
"trayecto": ["El tren sube por Despeñaperros. En el vagón, alguien empieza a cantar por bulerías. Nadie le para."]
}
