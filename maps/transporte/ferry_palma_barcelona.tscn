[node name="Camarero" type="Node2D" parent="Entities" unique_id=1375042580 instance=ExtResource("5_5lmil")]
position = Vector2(144, 112)
script = ExtResource("6_rc3j1")
lines = PackedStringArray("¿Un café? Cuatro euros. Es que estamos en alta mar. Bueno, a la salida del puerto, pero cuenta.", "Bocadillo de tortilla, nueve euros. Sin tortilla, siete. Es pan con aceite, pero aquí lo llamamos «mediterráneo».")
turn_to_player = true
sprite_sheet = ExtResource("7_ri5eu")

[node name="Sobrecargo" type="Node2D" parent="Entities" unique_id=464628291 instance=ExtResource("5_5lmil")]
position = Vector2(336, 336)
script = ExtResource("6_rc3j1")
lines = PackedStringArray("Por la puerta de abajo se baja al puerto. Cuando lleguemos, claro: nadar no te dejo.", "Si te mareas, mira al horizonte. Si no hay horizonte, mira al bar.")
turn_to_player = true
sprite_sheet = ExtResource("8_4nj8x")
initial_facing = 1

[node name="Ensaimadas" type="Node2D" parent="Entities" unique_id=90257708 instance=ExtResource("5_5lmil")]
position = Vector2(400, 208)
script = ExtResource("6_rc3j1")
lines = PackedStringArray("Llevo seis ensaimadas. Una es para mí y cinco para quedar bien con la familia de Badalona.")
turn_to_player = true
sprite_sheet = ExtResource("9_m8gpx")
initial_facing = 1

[node name="Mochilero" type="Node2D" parent="Entities" unique_id=307556583 instance=ExtResource("5_5lmil")]
