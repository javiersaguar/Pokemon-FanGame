[node name="Camarero" type="Node2D" parent="Entities" unique_id=959241188 instance=ExtResource("5_6y0ry")]
position = Vector2(144, 112)
script = ExtResource("6_4r7s0")
lines = PackedStringArray("¿Un café? Cuatro euros. Es que estamos en alta mar. Bueno, a la salida del puerto, pero cuenta.", "Bocadillo de tortilla, nueve euros. Sin tortilla, siete. Es pan con aceite, pero aquí lo llamamos «mediterráneo».")
turn_to_player = true
sprite_sheet = ExtResource("7_sq41q")

[node name="Sobrecargo" type="Node2D" parent="Entities" unique_id=357025767 instance=ExtResource("5_6y0ry")]
position = Vector2(336, 336)
script = ExtResource("6_4r7s0")
lines = PackedStringArray("Por la puerta de abajo se baja al puerto. Cuando lleguemos, claro: nadar no te dejo.", "Si te mareas, mira al horizonte. Si no hay horizonte, mira al bar.")
turn_to_player = true
sprite_sheet = ExtResource("8_k08lq")
initial_facing = 1

[node name="Raver" type="Node2D" parent="Entities" unique_id=726714477 instance=ExtResource("5_6y0ry")]
position = Vector2(400, 208)
script = ExtResource("6_4r7s0")
lines = PackedStringArray("Voy a Ibiza a trabajar. De relaciones públicas. Es decir, a repartir flyers en el West End.")
turn_to_player = true
sprite_sheet = ExtResource("9_xdbbw")
initial_facing = 1

[node name="Hippie" type="Node2D" parent="Entities" unique_id=1278249341 instance=ExtResource("5_6y0ry")]
