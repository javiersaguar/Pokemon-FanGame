event_params = {
"billete": "ssticket",
"hablante": "Megafonía",
"llegada": ["Estamos atracando en el puerto de Palma. Los pasajeros a pie, por la puerta de abajo. Bon dia!"],
"precio": 300,
"salida": ["Señores pasajeros, bienvenidos a bordo del ferry a Palma de Mallorca. Duración prevista: siete horas.", "El bar abre al salir del puerto. Las tumbonas de cubierta son por orden de llegada: una toalla encima no es una reserva."],
"trayecto": ["El ferry cruza el Mediterráneo de noche. Alguien ronca en el sofá de al lado. Puede que seas tú."],
"vuelta": ["barcelona/ciutat_vella", "from_ferry"]
}
mode = 1
