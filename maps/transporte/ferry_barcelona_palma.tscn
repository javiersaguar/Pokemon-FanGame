[node name="Camarero" type="Node2D" parent="Entities" unique_id=1136843441 instance=ExtResource("5_tnd31")]
position = Vector2(144, 112)
script = ExtResource("6_sjbr5")
lines = PackedStringArray("¿Un café? Cuatro euros. Es que estamos en alta mar. Bueno, a la salida del puerto, pero cuenta.", "Bocadillo de tortilla, nueve euros. Sin tortilla, siete. Es pan con aceite, pero aquí lo llamamos «mediterráneo».")
turn_to_player = true
sprite_sheet = ExtResource("7_x3q40")

[node name="Sobrecargo" type="Node2D" parent="Entities" unique_id=1132881878 instance=ExtResource("5_tnd31")]
position = Vector2(336, 336)
script = ExtResource("6_sjbr5")
lines = PackedStringArray("Por la puerta de abajo se baja al puerto. Cuando lleguemos, claro: nadar no te dejo.", "Si te mareas, mira al horizonte. Si no hay horizonte, mira al bar.")
turn_to_player = true
sprite_sheet = ExtResource("8_epyjo")
initial_facing = 1

[node name="Aleman" type="Node2D" parent="Entities" unique_id=1009672933 instance=ExtResource("5_tnd31")]
position = Vector2(400, 208)
script = ExtResource("6_sjbr5")
lines = PackedStringArray("Ich habe die Tumbona reserviert. Con la toalla, ja. Desde Barcelona.", "En Mallorca hablamos todos alemán. Los mallorquines también, pero no les gusta.")
turn_to_player = true
sprite_sheet = ExtResource("9_onjxj")
initial_facing = 1

[node name="Abuela" type="Node2D" parent="Entities" unique_id=676266281 instance=ExtResource("5_tnd31")]
position = Vector2(112, 272)
script = ExtResource("6_sjbr5")
lines = PackedStringArray("Voy a Palma a ver a mi nieta. Le llevo fuet, que dice que allí no hay del bueno.", "Y una ensaimada de vuelta. En la caja redonda, que si no te miran mal en el puerto.")
turn_to_player = true
sprite_sheet = ExtResource("10_0m7ih")
initial_facing = 2

[node name="Regatista" type="Node2D" parent="Entities" unique_id=1215386901 instance=ExtResource("5_tnd31")]
position = Vector2(432, 304)
script = ExtResource("6_sjbr5")
lines = PackedStringArray("Voy a la regata de la Copa del Rey. Del de ahora, que el otro ya navega en Sanxenxo.")
turn_to_player = true
sprite_sheet = ExtResource("11_vef23")
