event_params = {
"hablante": "Megafonía",
"llegada": ["Llegamos a San Miguel de Bernuy con veinte minutos de retraso. Se han cruzado unas ovejas.", "Población: pocos. Buitres: muchos. Gracias por elegir Renfe."],
"salida": ["Renfe les da la bienvenida a bordo del AVE con destino San Miguel de Bernuy. Sí, ese San Miguel.", "El apeadero se inauguró la semana pasada. Dicen que lo pidió un tal Javier, que tiene muchas medallas."],
"trayecto": ["El tren cruza el túnel de Guadarrama, para en Segovia-Guiomar y sigue por la Tierra de Pinares. Huele a resina y a cochinillo."]
}
