[node name="Segoviana" type="Node2D" parent="Entities" unique_id=1496058102 instance=ExtResource("5_ju7av")]
position = Vector2(80, 304)
script = ExtResource("6_2hkn4")
lines = PackedStringArray("Vuelvo al pueblo para las fiestas. En Madrid no hay quien duerma, y en San Miguel no hay quien no duerma.")
