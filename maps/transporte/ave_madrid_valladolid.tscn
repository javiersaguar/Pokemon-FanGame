position = Vector2(272, 144)
script = ExtResource("6_t5cx2")
lines = PackedStringArray("Billetes, por favor. ¿Tarjeta Dorada? ¿Carné joven? ¿Abono? Da igual: el retraso es para todos.", "Si el tren llega con más de una hora de retraso, le devolvemos la mitad. Por eso llegamos con cincuenta y nueve minutos.")
