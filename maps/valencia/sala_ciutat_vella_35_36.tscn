display_name = "Padre de familia valenciano"
lines = PackedStringArray("En marzo dormimos con tapones. Los petardos empiezan el día uno y paran cuando arde la última falla.", "Mi hijo tiró un petardo en el patio a las siete de la mañana. Los vecinos aplaudieron: es tradición.")
