script = ExtResource("6_v1ooi")
display_name = "Madre de familia valenciana"
lines = PackedStringArray("Los domingos hay paella, como Dios manda. Los lunes, arroz al horno con lo que sobra. Nunca sobra.", "Aquí se discute de fútbol, de política y de si el arroz se remueve. El arroz no se remueve. Punto.")
