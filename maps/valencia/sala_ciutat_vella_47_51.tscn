display_name = "Diseñador de Ruzafa"
lines = PackedStringArray("Ruzafa era un barrio de abuelas. Ahora es un barrio de cafeterías de especialidad con abuelas que no pueden pagar el café.", "Mi estudio es un antiguo ultramarinos. Lo único que conservo del ultramarinos es el precio de los alquileres de antes en una foto.")
