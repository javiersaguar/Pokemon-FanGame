display_name = "Abuela de Ruzafa"
lines = PackedStringArray("Abajo había una mercería. Ahora hay un local de brunch. El brunch es un desayuno que se toma tarde y se paga caro.", "Los chicos jóvenes son muy majos. Me suben la compra y me preguntan si quiero vender el piso.")
