position = Vector2(48, 176)
script = ExtResource("6_g2got")
display_name = "Compañera de piso"
lines = PackedStringArray("Entreno natación en el mar todas las mañanas. Él me mira desde la orilla esperando la ola que nunca llega.", "El piso huele a neopreno y a crema solar. Mi madre dice que huele a «no tengo pareja».")
turn_to_player = true
