[node name="SurfistaEterno" type="Node2D" parent="Entities" unique_id=1909725456 instance=ExtResource("5_wrofr")]
position = Vector2(272, 176)
script = ExtResource("6_g2got")
display_name = "Surfista eterno"
lines = PackedStringArray("En Valencia casi nunca hay olas. Por eso soy surfista: me paso el año esperando y el día que hay olas no voy porque trabajo.", "Tengo seis tablas y ningún sofá. Me siento en la tabla más gorda.")
