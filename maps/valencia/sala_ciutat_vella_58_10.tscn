display_name = "Expionero del bakalao"
lines = PackedStringArray("En los noventa iba de discoteca en discoteca de viernes a lunes. Ahora voy de la farmacia al ambulatorio, pero con la misma energía.", "Mi hijo me dice que su música es electrónica. Le pongo un vinilo del 93 y llora.")
