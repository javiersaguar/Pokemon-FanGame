[node name="HuertanoDeLaChufa" type="Node2D" parent="Entities" unique_id=1496825288 instance=ExtResource("5_b2bpb")]
position = Vector2(336, 112)
script = ExtResource("6_lef88")
display_name = "Huertano de la chufa"
lines = PackedStringArray("Cultivo chufa en Alboraya desde que tengo uso de razón. Sin chufa no hay horchata, y sin horchata no hay verano.", "Me han ofrecido un dineral por mis campos para hacer pisos. Les he dicho que la horchata de ladrillo no la quiere nadie.")
