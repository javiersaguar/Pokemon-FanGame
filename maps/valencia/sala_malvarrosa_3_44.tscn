sprite_sheet = ExtResource("7_xlfoa")

[node name="SuMujer" type="Node2D" parent="Entities" unique_id=360845231 instance=ExtResource("5_b2bpb")]
position = Vector2(272, 112)
script = ExtResource("6_lef88")
display_name = "Su mujer"
lines = PackedStringArray("Lavo la chufa tres veces y la dejo secar al sol en el terrado. El sol lo pone gratis la Virgen.", "Si un turista me pregunta si la horchata lleva leche, le doy un vaso y lo dejo pensando.")
turn_to_player = true
