[node name="CamareroDelAlmuerzo" type="Node2D" parent="Entities" unique_id=713495600 instance=ExtResource("5_0ay3p")]
position = Vector2(176, 112)
script = ExtResource("6_tk0dd")
display_name = "Camarero del almuerzo"
lines = PackedStringArray("El esmorzaret es a las diez y media: bocadillo de medio metro, cacaos, olivas, cerveza y cremaet. Luego se vuelve a trabajar, en teoría.", "El bocadillo de chivito con huevo es para valientes. El de blanco y negro, para los que ya no tienen nada que perder.")
