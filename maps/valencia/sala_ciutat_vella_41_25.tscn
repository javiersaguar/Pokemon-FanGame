sprite_sheet = ExtResource("7_jw6u8")

[node name="ObreroAlmorzando" type="Node2D" parent="Entities" unique_id=1631326880 instance=ExtResource("5_0ay3p")]
position = Vector2(144, 208)
script = ExtResource("6_tk0dd")
display_name = "Obrero almorzando"
lines = PackedStringArray("Llevo treinta años almorzando aquí. La obra de enfrente lleva veinte; el almuerzo es lo único que se termina.", "El cremaet lleva ron, café y canela, y se prende fuego. Es lo más parecido a una falla que se puede beber.")
