[node name="VendedoraDeFruta" type="Node2D" parent="Entities" unique_id=1029615459 instance=ExtResource("5_tshlt")]
position = Vector2(272, 176)
script = ExtResource("6_80wqh")
display_name = "Vendedora de fruta"
lines = PackedStringArray("Naranjas de la huerta, recién cogidas. Las de la Mercadona también son de la huerta, pero de otra huerta más lejos.", "Aquí se viene a comprar y a hablar. Comprar se compra poco; hablar, muchísimo.")
turn_to_player = true
sprite_sheet = ExtResource("7_4j2l5")

[node name="VendedorDeEmbutido" type="Node2D" parent="Entities" unique_id=453146802 instance=ExtResource("5_tshlt")]
position = Vector2(112, 144)
script = ExtResource("6_80wqh")
display_name = "Vendedor de embutido"
lines = PackedStringArray("Este jamón tiene más curación que todos los centros de salud del barrio.", "Si me pide que se lo corte fino, le corto fino. Si me pide que se lo corte barato, eso ya no.")
turn_to_player = true
sprite_sheet = ExtResource("8_6paee")

[node name="SenoraConCapazo" type="Node2D" parent="Entities" unique_id=1107909135 instance=ExtResource("5_tshlt")]
position = Vector2(240, 176)
script = ExtResource("6_80wqh")
display_name = "Señora con capazo"
lines = PackedStringArray("Vengo cada mañana con mi capazo desde 1970. La cúpula de hierro me ha visto envejecer y yo a ella oxidarse.", "Los turistas compran zumo y se van. Nosotras compramos para la semana y para criticar.")
turn_to_player = true
sprite_sheet = ExtResource("9_awx8u")
initial_facing = 3

