display_name = "Alumno ejecutivo"
lines = PackedStringArray("Me apunté a vela para desconectar. Me he caído al agua seis veces con el móvil del trabajo en el bolsillo.", "Mi monitor dice que hay que leer el viento. Yo leo el correo, que también sopla fuerte.")
