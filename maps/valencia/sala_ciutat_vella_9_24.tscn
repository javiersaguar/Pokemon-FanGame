display_name = "Guía de la Lonja"
lines = PackedStringArray("En este salón se compraba y se vendía seda. Las columnas retorcidas son palmeras de piedra: el primer jardín vertical.", "En la puerta pone que el comerciante que no mienta irá al cielo. Es la frase más optimista de Valencia.")
