position = Vector2(240, 80)
script = ExtResource("6_7cgrv")
display_name = "Canónigo del Santo Cáliz"
lines = PackedStringArray("Aquí se guarda el Santo Grial. El de verdad, no el de las películas. Bueno, eso dice la tradición, y la tradición aquí tiene mucha fuerza.", "Los jueves el Tribunal de las Aguas se sienta en la puerta. Mientras ellos reparten agua, yo reparto paciencia.")
