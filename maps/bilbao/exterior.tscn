[node name="Aitona" type="Node2D" parent="Entities" unique_id=1498888619 instance=ExtResource("10_dknog")]
position = Vector2(1488, 592)
script = ExtResource("11_208x0")
lines = PackedStringArray("Bilbao es la capital del mundo. Lo sabe todo el mundo, menos el mundo.", "¿Que de dónde soy? De Bilbao. ¿Que dónde nací? Donde me dio la gana.")
turn_to_player = true
sprite_sheet = ExtResource("12_sgu4m")

[node name="Hincha" type="Node2D" parent="Entities" unique_id=1646892724 instance=ExtResource("10_dknog")]
position = Vector2(464, 560)
script = ExtResource("11_208x0")
lines = PackedStringArray("En el Athletic solo juegan los de aquí. Bueno, los de aquí, los de allí y los que tengan una abuela de aquí.", "¡Aupa Athletic! ¿Vas al gimnasio? La líder no perdona. La grada, tampoco.")
turn_to_player = true
sprite_sheet = ExtResource("13_bmvxv")

[node name="Pintxera" type="Node2D" parent="Entities" unique_id=1206360892 instance=ExtResource("10_dknog")]
position = Vector2(1488, 1392)
script = ExtResource("11_208x0")
lines = PackedStringArray("Un pintxo, un euro con ochenta. Dos pintxos, la ruina. Tres, ya eres de aquí.", "La gilda: guindilla, anchoa y aceituna. Picante, salada y verde, como el Athletic. No, el Athletic no es verde.")
turn_to_player = true
sprite_sheet = ExtResource("14_xjyqy")

