position = Vector2(720, 528)
script = ExtResource("6_nxtbm")
lines = PackedStringArray("SAN MAMÉS · GIMNASIO 6.", "La Catedral del fútbol. Dentro, la grada canta noventa minutos y no se calla ni en el descanso.")
show_sprite = false

[node name="CartelGuggenheim" type="Node2D" parent="Entities" unique_id=568263496 instance=ExtResource("5_3vpdh")]
position = Vector2(688, 944)
script = ExtResource("6_nxtbm")
lines = PackedStringArray("MUSEO GUGGENHEIM · FRANK GEHRY.", "Titanio, cristal y piedra. Delante, Puppy: un perro de doce metros hecho de flores. Le cambian las flores dos veces al año.")
show_sprite = false

[node name="CartelZubizuri" type="Node2D" parent="Entities" unique_id=363571093 instance=ExtResource("5_3vpdh")]
position = Vector2(624, 1104)
script = ExtResource("6_nxtbm")
lines = PackedStringArray("ZUBIZURI · CALATRAVA.", "El suelo de cristal resbala con la lluvia. En Bilbao llueve. Haz las cuentas.")
show_sprite = false

[node name="CartelArriaga" type="Node2D" parent="Entities" unique_id=1070987848 instance=ExtResource("5_3vpdh")]
position = Vector2(1872, 752)
script = ExtResource("6_nxtbm")
lines = PackedStringArray("TEATRO ARRIAGA.", "Ópera, teatro y la ría delante. Aquí el drama se paga con entrada.")
show_sprite = false

[node name="CartelRibera" type="Node2D" parent="Entities" unique_id=1453931667 instance=ExtResource("5_3vpdh")]
position = Vector2(2032, 1168)
script = ExtResource("6_nxtbm")
lines = PackedStringArray("MERCADO DE LA RIBERA.", "Uno de los mercados cubiertos más grandes de Europa. Bacalao, pintxos y señoras que saben más que tú.")
show_sprite = false

[node name="CartelSieteCalles" type="Node2D" parent="Entities" unique_id=1840849431 instance=ExtResource("5_3vpdh")]
position = Vector2(1840, 1648)
script = ExtResource("6_nxtbm")
lines = PackedStringArray("SIETE CALLES · CASCO VIEJO.", "Pintxo y txikito en cada bar. Se recomienda ir por orden. Nadie lo consigue.")
show_sprite = false

[node name="CartelArtxanda" type="Node2D" parent="Entities" unique_id=1800370916 instance=ExtResource("5_3vpdh")]
position = Vector2(2064, 464)
script = ExtResource("6_nxtbm")
lines = PackedStringArray("FUNICULAR DE ARTXANDA.", "Arriba, el mirador de todo Bilbao. El funicular está en obras; la cuesta, no.")
show_sprite = false

[node name="CartelTorre" type="Node2D" parent="Entities" unique_id=405789332 instance=ExtResource("5_3vpdh")]
position = Vector2(1104, 688)
script = ExtResource("6_nxtbm")
lines = PackedStringArray("TORRE IBERDROLA.", "165 metros. Desde arriba se ve la factura de la luz de toda la ciudad.")
show_sprite = false

