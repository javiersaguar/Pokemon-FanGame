display_name = "Soprano"
lines = PackedStringArray("El Arriaga lleva el nombre de Juan Crisóstomo Arriaga, el Mozart español. Murió con diecinueve años y ya había compuesto una sinfonía.", "Esta noche cantamos ópera. En el entreacto, pintxos en el foyer. Aquí hasta la ópera tiene pintxos.")
