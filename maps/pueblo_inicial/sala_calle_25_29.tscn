display_name = "Vecino teletrabajador"
lines = PackedStringArray("Me vine de Madrid a teletrabajar en el pueblo. Tengo fibra, vistas al embalse y silencio. Bueno, y cigüeñas.", "En Madrid tardaba una hora en llegar a la oficina. Aquí tardo diez segundos en llegar al ordenador. Y cinco al bar.")
