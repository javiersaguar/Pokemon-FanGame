[node name="Cochero" type="Node2D" parent="Entities" unique_id=946546499 instance=ExtResource("10_qsueu")]
position = Vector2(944, 1424)
script = ExtResource("11_tcndv")
lines = PackedStringArray("¿Un paseo en coche de caballos? Cincuenta euros la media hora. El caballo cobra en zanahorias.", "Este verano subimos a sesenta: el calor también se cobra.")
turn_to_player = true
sprite_sheet = ExtResource("12_h0ie2")

[node name="Guia" type="Node2D" parent="Entities" unique_id=529303528 instance=ExtResource("10_qsueu")]
position = Vector2(592, 1040)
script = ExtResource("11_tcndv")
lines = PackedStringArray("¿Sabías que la Giralda tiene 35 rampas? Me lo sé porque las subo diez veces al día. Por la mañana.")
turn_to_player = true
sprite_sheet = ExtResource("13_sineb")
initial_facing = 2

[node name="Vecina" type="Node2D" parent="Entities" unique_id=502845563 instance=ExtResource("10_qsueu")]
position = Vector2(1296, 1328)
script = ExtResource("11_tcndv")
lines = PackedStringArray("Llevo ochenta años en Santa Cruz. Ahora mis vecinos son maletas con ruedas. Bueno, al menos saludan.")
turn_to_player = true
sprite_sheet = ExtResource("14_8pr7a")
initial_facing = 3

[node name="Turista" type="Node2D" parent="Entities" unique_id=106025256 instance=ExtResource("10_qsueu")]
position = Vector2(944, 464)
script = ExtResource("11_tcndv")
lines = PackedStringArray("Las Setas de día son bonitas y de noche dan sombra. En Sevilla, eso vale más que el oro.")
turn_to_player = true
