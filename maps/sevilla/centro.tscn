[node name="CartelGiralda" type="Node2D" parent="Entities" unique_id=800718574 instance=ExtResource("5_iup65")]
position = Vector2(1008, 1328)
script = ExtResource("6_o5cjw")
lines = PackedStringArray("LA GIRALDA.", "Alminar almohade del siglo XII con campanario cristiano encima: 104 metros. Se sube por rampas, que en", "la época subían a caballo. Hoy se sube a pie y se baja con agujetas.")
show_sprite = false

[node name="CartelCatedral" type="Node2D" parent="Entities" unique_id=1201157731 instance=ExtResource("5_iup65")]
position = Vector2(592, 1328)
script = ExtResource("6_o5cjw")
lines = PackedStringArray("CATEDRAL DE SANTA MARÍA DE LA SEDE.", "La catedral gótica más grande del mundo. Dentro está la tumba de Colón. O parte de Colón: lo demás", "está en Santo Domingo, según a quién preguntes.")
show_sprite = false

[node name="CartelSetas" type="Node2D" parent="Entities" unique_id=378224915 instance=ExtResource("5_iup65")]
position = Vector2(1104, 400)
script = ExtResource("6_o5cjw")
lines = PackedStringArray("METROPOL PARASOL · LAS SETAS.", "La estructura de madera más grande del mundo. Costó el doble de lo previsto. Muy sevillano y muy español.")
show_sprite = false

[node name="CartelAlcazar" type="Node2D" parent="Entities" unique_id=1308267833 instance=ExtResource("5_iup65")]
position = Vector2(656, 1680)
script = ExtResource("6_o5cjw")
lines = PackedStringArray("REAL ALCÁZAR · PUERTA DEL LEÓN.", "Palacio real en uso más antiguo de Europa. Aquí se rodó Juego de Tronos: el trono, de momento, sigue libre.")
show_sprite = false

[node name="CartelArchivo" type="Node2D" parent="Entities" unique_id=1188948075 instance=ExtResource("5_iup65")]
position = Vector2(1200, 1488)
script = ExtResource("6_o5cjw")
lines = PackedStringArray("ARCHIVO GENERAL DE INDIAS.", "Ochenta millones de páginas sobre América. Aquí se guarda hasta la factura de las carabelas. Sin pagar.")
show_sprite = false

[node name="CartelSantaCruz" type="Node2D" parent="Entities" unique_id=1047914696 instance=ExtResource("5_iup65")]
position = Vector2(1136, 1104)
script = ExtResource("6_o5cjw")
lines = PackedStringArray("BARRIO DE SANTA CRUZ.", "Callejones de la antigua judería. Hay más pisos turísticos que vecinos y más vecinos que sitio para tender.")
show_sprite = false

[node name="CartelEste" type="Node2D" parent="Entities" unique_id=2049782435 instance=ExtResource("5_iup65")]
position = Vector2(2000, 432)
script = ExtResource("6_o5cjw")
lines = PackedStringArray("→ Ruta 13 · Mar de olivos (Córdoba).", "Agua y gorra: en Sevilla en agosto no se combate, se sobrevive.")
show_sprite = false

[node name="CartelSur" type="Node2D" parent="Entities" unique_id=1159605268 instance=ExtResource("5_iup65")]
position = Vector2(1232, 1744)
script = ExtResource("6_o5cjw")
lines = PackedStringArray("↓ Parque de María Luisa y Plaza de España.")
