[node name="CartelGiralda" type="Node2D" parent="Entities" unique_id=1970307200 instance=ExtResource("5_0vu63")]
position = Vector2(1008, 1328)
script = ExtResource("6_lq1r7")
lines = PackedStringArray("LA GIRALDA.", "Alminar almohade del siglo XII con campanario cristiano encima: 104 metros. Se sube por rampas, que en", "la época subían a caballo. Hoy se sube a pie y se baja con agujetas.")
show_sprite = false

[node name="CartelCatedral" type="Node2D" parent="Entities" unique_id=655993062 instance=ExtResource("5_0vu63")]
position = Vector2(592, 1328)
script = ExtResource("6_lq1r7")
lines = PackedStringArray("CATEDRAL DE SANTA MARÍA DE LA SEDE.", "La catedral gótica más grande del mundo. Dentro está la tumba de Colón. O parte de Colón: lo demás", "está en Santo Domingo, según a quién preguntes.")
show_sprite = false

[node name="CartelSetas" type="Node2D" parent="Entities" unique_id=1940596159 instance=ExtResource("5_0vu63")]
position = Vector2(1104, 400)
script = ExtResource("6_lq1r7")
lines = PackedStringArray("METROPOL PARASOL · LAS SETAS.", "La estructura de madera más grande del mundo. Costó el doble de lo previsto. Muy sevillano y muy español.")
show_sprite = false

[node name="CartelAlcazar" type="Node2D" parent="Entities" unique_id=1471862726 instance=ExtResource("5_0vu63")]
