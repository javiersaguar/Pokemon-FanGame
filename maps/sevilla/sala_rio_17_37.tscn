[node name="MaestraDeBaile" type="Node2D" parent="Entities" unique_id=657930063 instance=ExtResource("5_bttp7")]
position = Vector2(336, 112)
script = ExtResource("6_qg4r0")
display_name = "Maestra de baile"
lines = PackedStringArray("El baile empieza en los pies, sube por la cintura y acaba en la mirada. A mis alumnas japonesas les sale la mirada antes que los pies.", "Las sevillanas tienen cuatro partes. Las alumnas aprenden la primera en un mes y la cuarta en cinco años.")
turn_to_player = true
sprite_sheet = ExtResource("8_sp44w")
initial_facing = 1

[node name="AlumnaDeOsaka" type="Node2D" parent="Entities" unique_id=150613372 instance=ExtResource("5_bttp7")]
position = Vector2(208, 240)
script = ExtResource("6_qg4r0")
display_name = "Alumna de Osaka"
lines = PackedStringArray("Llevo seis años estudiando flamenco en Osaka. Aquí me han dicho que bailo con mucha técnica. No sé si es bueno.", "En mi país el flamenco es muy famoso. Hay más academias que en Sevilla, pero con menos calor.")
turn_to_player = true
sprite_sheet = ExtResource("8_hi366")
initial_facing = 3

[node name="AlumnoJubilado" type="Node2D" parent="Entities" unique_id=728213804 instance=ExtResource("5_bttp7")]
position = Vector2(112, 240)
script = ExtResource("6_qg4r0")
display_name = "Alumno jubilado"
lines = PackedStringArray("Me apunté a flamenco a los setenta. Mi traumatólogo y yo nos vemos mucho.", "Taconeo poco, pero con mucho sentimiento. Los vecinos de abajo lo notan igual.")
turn_to_player = true
sprite_sheet = ExtResource("9_plhy0")
initial_facing = 3

