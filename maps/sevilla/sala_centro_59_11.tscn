display_name = "Taquillero de autobuses"
lines = PackedStringArray("El autobús a Córdoba sale por la Ruta 13. Lleva aire acondicionado, que en agosto es como llevar un milagro.", "Los billetes se compran aquí o en la aplicación. La aplicación funciona cuando no hace falta.")
