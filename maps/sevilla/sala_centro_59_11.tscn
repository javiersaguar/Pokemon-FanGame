script = ExtResource("6_uiguo")
display_name = "Viajera con maleta"
lines = PackedStringArray("Voy a ver a mi hija a Córdoba. Le llevo un táper de espinacas con garbanzos y otro de opiniones.", "Llevo media hora esperando. Aquí la puntualidad es como la nieve: se habla de ella, pero nadie la ha visto.")
