[node name="MarineroDelMuseo" type="Node2D" parent="Entities" unique_id=494453099 instance=ExtResource("5_rn0k4")]
position = Vector2(176, 144)
script = ExtResource("6_1kagu")
display_name = "Marinero del museo"
lines = PackedStringArray("La Torre del Oro se llama así por los azulejos dorados que tenía, no por el oro de América. El oro de América no se quedó aquí mucho tiempo.", "Desde arriba se cerraba el río con una cadena para que no entraran barcos. Ahora entran cruceros y no hay cadena que valga.")
