sprite_sheet = ExtResource("7_thcf5")

[node name="NinoConCatalejo" type="Node2D" parent="Entities" unique_id=2070202971 instance=ExtResource("5_rn0k4")]
position = Vector2(176, 176)
script = ExtResource("6_1kagu")
display_name = "Niño con catalejo"
lines = PackedStringArray("Con el catalejo veo la Giralda, el puente y a mi madre llamándome desde la orilla.", "De mayor quiero ser capitán de barco. O de autobús turístico, que también se mueve.")
