[node name="VecinaQueLoAdopta" type="Node2D" parent="Entities" unique_id=1950364210 instance=ExtResource("5_n0rpv")]
position = Vector2(112, 144)
script = ExtResource("6_esrjb")
display_name = "Vecina que lo adopta"
lines = PackedStringArray("Le subo croquetas al madrileño para que no se muera de pena. Come como si no hubiera comido nunca.", "Le he explicado que en agosto no se sale a la calle hasta las nueve. Ayer salió a las cinco y volvió sin sombra.")
