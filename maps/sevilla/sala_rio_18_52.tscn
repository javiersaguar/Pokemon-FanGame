display_name = "Madrileño recién llegado"
lines = PackedStringArray("Me he mudado a Sevilla por el teletrabajo. Aquí el alquiler es más barato y el calor, más caro.", "Intento hablar como los de aquí y me miran raro. He dicho «illo» con acento de Lavapiés.")
