script = ExtResource("6_h0j2d")
display_name = "Confitera"
lines = PackedStringArray("Las yemas de San Leandro las hacen las monjas detrás de un torno. Yo las vendo delante, con un poco más de sonrisa.", "Un polvorón se aprieta antes de abrirlo. Si no, se deshace, como los planes de dieta en diciembre.")
