script = ExtResource("6_kf0tx")
display_name = "Su pareja"
lines = PackedStringArray("Él se sabe la historia de cada piedra de Sevilla y no se sabe dónde está el detergente.", "Los domingos me lleva a sitios turísticos. Dice que es para practicar. Yo creo que es para no pagar la entrada.")
