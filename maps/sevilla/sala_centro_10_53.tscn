display_name = "Guía turístico"
lines = PackedStringArray("Hago la ruta de Sevilla en tres idiomas. En el cuarto idioma invento un poco y nadie se queja.", "La pregunta que más me hacen es dónde se come barato. Respondo con la mirada: en casa de tu madre.")
