display_name = "Su sobrina animalista"
lines = PackedStringArray("Mi tío me cuenta sus faenas y yo le cuento por qué no deberían existir. Comemos juntos los domingos, en silencio.", "Le he regalado un libro sobre derechos de los animales. Lo usa para calzar la mesa.")
