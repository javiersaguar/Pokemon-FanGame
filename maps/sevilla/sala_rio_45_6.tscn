display_name = "Torero retirado"
lines = PackedStringArray("Toreé en la Maestranza tres tardes. En la tercera me cogió un toro y me retiré a contarlo en los bares.", "El traje de luces lo guardo en el armario. Pesa como una armadura y brilla como una discoteca.")
