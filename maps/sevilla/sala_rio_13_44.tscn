position = Vector2(304, 112)
script = ExtResource("6_x2ve3")
display_name = "Su mujer"
lines = PackedStringArray("Los altramuces los pongo en remojo una semana. La casa huele a río y a domingo.", "Mi marido conoce a todos los jugadores del Betis desde la puerta de la grada. A los buenos les regala un cucurucho.")
turn_to_player = true
sprite_sheet = ExtResource("7_klhc8")
initial_facing = 3

