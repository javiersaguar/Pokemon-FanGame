position = Vector2(272, 208)
script = ExtResource("6_x2ve3")
display_name = "Vendedor de altramuces"
lines = PackedStringArray("Vendo altramuces, garbanzos tostados y avellanas en la puerta del estadio. Sin mí, los partidos serían en silencio.", "Los altramuces se pelan con los dientes. Es el único deporte que practican los aficionados durante el partido.")
