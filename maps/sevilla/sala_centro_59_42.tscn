display_name = "Parroquiana de los caracoles"
lines = PackedStringArray("Me como dos platos de caracoles cada tarde de mayo. Mi médico dice que es demasiado; mi médico es de Burgos.", "Un caracol se saca con un palillo y paciencia. La paciencia es lo que no se vende en esta ciudad.")
