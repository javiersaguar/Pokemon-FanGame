[node name="Bailaora" type="Node2D" parent="Entities" unique_id=1372084789 instance=ExtResource("5_magir")]
position = Vector2(112, 80)
script = ExtResource("6_ux62q")
display_name = "Bailaora"
lines = PackedStringArray("Bailo seis pases al día para turistas. Al último ya lo bailo con el alma y con las rodillas en llamas.", "El taconeo se aprende de pequeña. El vecino de abajo también lo aprendió, a su pesar.")
