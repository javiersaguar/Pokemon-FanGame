script = ExtResource("6_ux62q")
display_name = "Cantaor"
lines = PackedStringArray("El cante jondo sale de dentro. Hoy me sale de dentro un dolor de garganta, pero cantamos igual.", "Los turistas aplauden a destiempo. Hemos adaptado el compás para que coincida con su entusiasmo.")
