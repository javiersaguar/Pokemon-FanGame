[node name="GuiaDelAlcazar" type="Node2D" parent="Entities" unique_id=1272422834 instance=ExtResource("5_v21ae")]
position = Vector2(272, 208)
script = ExtResource("6_faa0p")
display_name = "Guía del Alcázar"
lines = PackedStringArray("El Alcázar sigue siendo palacio real: cuando viene el rey, duerme arriba. Cuando no, duermen los turistas en la cola.", "Aquí se rodó una serie de dragones. Desde entonces vienen fans preguntando por el trono. El trono está en Madrid, les digo.")
turn_to_player = true
sprite_sheet = ExtResource("7_gwx2p")

[node name="FanDeLaSerie" type="Node2D" parent="Entities" unique_id=1455936923 instance=ExtResource("5_v21ae")]
position = Vector2(304, 112)
script = ExtResource("6_faa0p")
display_name = "Fan de la serie"
lines = PackedStringArray("En la serie esto era otro reino. Me he traído una capa y una espada de plástico. Seguridad me ha quitado la espada.", "He visto el estanque donde salía una princesa. Ahora sale una carpa naranja que me mira con desprecio.")
turn_to_player = true
sprite_sheet = ExtResource("8_m1nhg")
initial_facing = 2

