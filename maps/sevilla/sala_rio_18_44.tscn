initial_facing = 1

[node name="ClientaDelMono" type="Node2D" parent="Entities" unique_id=188534485 instance=ExtResource("5_xog5m")]
position = Vector2(144, 144)
script = ExtResource("6_m1m8b")
display_name = "Clienta del moño"
lines = PackedStringArray("Me han puesto cuarenta horquillas. Si paso por el arco de seguridad del aeropuerto, me detienen.", "Este moño tiene que durar tres días de feria. Dormiré sentada, como los caballos.")
