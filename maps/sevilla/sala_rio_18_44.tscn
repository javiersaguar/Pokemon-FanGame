[node name="PeluqueraDeFeria" type="Node2D" parent="Entities" unique_id=457627866 instance=ExtResource("5_xog5m")]
position = Vector2(272, 144)
script = ExtResource("6_m1m8b")
display_name = "Peluquera de feria"
lines = PackedStringArray("En abril hago doscientos moños de flamenca. Gomina, horquillas y una oración para que aguanten hasta el lunes.", "La flor del pelo va a un lado si estás soltera y al otro si estás casada. Algunas la ponen en medio para despistar.")
