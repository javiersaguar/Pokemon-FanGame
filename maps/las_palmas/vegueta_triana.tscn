lines = PackedStringArray("CASA DE COLÓN.", "Colón paró aquí en tres de sus cuatro viajes. A reparar la Pinta y a por papas arrugadas.")
show_sprite = false

[node name="CartelTriana" type="Node2D" parent="Entities" unique_id=850886401 instance=ExtResource("5_lk1lq")]
