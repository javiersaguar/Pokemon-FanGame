position = Vector2(880, 1264)
script = ExtResource("6_064bl")
lines = PackedStringArray("CATEDRAL DE SANTA ANA.", "Cuatro siglos de obras: gótica por dentro, neoclásica por fuera. Delante, ocho perros de bronce.", "Son los presa canarios que dieron nombre a las islas. O eso dicen los perros.")
