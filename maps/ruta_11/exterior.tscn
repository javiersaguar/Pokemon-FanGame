[node name="CartelSalinas" type="Node2D" parent="Entities" unique_id=51347933 instance=ExtResource("5_hd00g")]
position = Vector2(1904, 720)
script = ExtResource("6_rkr84")
lines = PackedStringArray("SALINAS DE SANTA POLA.", "Los flamencos vienen por la sal. Los turistas, por los flamencos. La sal se va en camiones.")
show_sprite = false

[node name="CartelPalmeral" type="Node2D" parent="Entities" unique_id=614641295 instance=ExtResource("5_hd00g")]
position = Vector2(1776, 496)
script = ExtResource("6_rkr84")
lines = PackedStringArray("PALMERAL DE ELCHE · Patrimonio de la Humanidad.", "Doscientas mil palmeras que plantaron los árabes. La Palmera Imperial tiene siete brazos y ningún cuñado que los pode.")
show_sprite = false

[node name="CartelBasilica" type="Node2D" parent="Entities" unique_id=258181784 instance=ExtResource("5_hd00g")]
position = Vector2(1232, 944)
script = ExtResource("6_rkr84")
lines = PackedStringArray("BASÍLICA DE SANTA MARÍA.", "Aquí se canta el Misteri d\'Elx desde la Edad Media. Un ángel baja del techo colgado de una cuerda, sin prevención de riesgos.")
show_sprite = false

[node name="CartelDama" type="Node2D" parent="Entities" unique_id=1641726560 instance=ExtResource("5_hd00g")]
position = Vector2(1360, 816)
script = ExtResource("6_rkr84")
lines = PackedStringArray("DAMA DE ELCHE (copia).", "La de verdad está en Madrid desde 1941. En Elche la piden cada año; en Madrid contestan que ya si eso.")
show_sprite = false

[node name="CartelCalzado" type="Node2D" parent="Entities" unique_id=189709616 instance=ExtResource("5_hd00g")]
position = Vector2(1520, 944)
script = ExtResource("6_rkr84")
lines = PackedStringArray("FÁBRICA DE CALZADO.", "Zapato cosido en Elche, etiqueta puesta en Italia. Se buscan aparadoras: contrato de palabra, sueldo de susurro.")
show_sprite = false

[node name="CartelOrihuela" type="Node2D" parent="Entities" unique_id=246631787 instance=ExtResource("5_hd00g")]
position = Vector2(944, 784)
script = ExtResource("6_rkr84")
lines = PackedStringArray("ORIHUELA · Busto de Miguel Hernández.", "Poeta y pastor de cabras. Murió en la cárcel en 1942. El instituto, la calle y el aeropuerto llevan ahora su nombre.")
show_sprite = false

[node name="CartelMurcia" type="Node2D" parent="Entities" unique_id=920964006 instance=ExtResource("5_hd00g")]
position = Vector2(80, 496)
script = ExtResource("6_rkr84")
