[node name="Aparadora" type="Node2D" parent="Entities" unique_id=1936847428 instance=ExtResource("10_svg3b")]
position = Vector2(1616, 976)
script = ExtResource("11_s4thk")
lines = PackedStringArray("Llevo cuarenta años cosiendo zapatos en la cocina de mi casa. Cotizados tengo once.", "El par sale de aquí a doce euros y lo verás en un escaparate a doscientos. Algo se pierde por el camino.")
turn_to_player = true
sprite_sheet = ExtResource("12_jmt3v")

[node name="Palmerero" type="Node2D" parent="Entities" unique_id=911975852 instance=ExtResource("10_svg3b")]
position = Vector2(1104, 496)
script = ExtResource("11_s4thk")
lines = PackedStringArray("Subo a las palmeras con una cuerda y una hoz. El seguro no lo quiere ni oír.", "El picudo rojo se come una palmera en un año. Es el único bicho que aquí trabaja más que yo.")
turn_to_player = true
sprite_sheet = ExtResource("13_p6xt3")
initial_facing = 3

[node name="Huertana" type="Node2D" parent="Entities" unique_id=984861019 instance=ExtResource("10_svg3b")]
position = Vector2(400, 464)
script = ExtResource("11_s4thk")
lines = PackedStringArray("Las granadas me las pagan a veinte céntimos el kilo. Este año las dejo en el árbol: me sale más barato.", "El trasvase llega cuando llueve en Madrid. Aquí no llueve; aquí se discute.")
turn_to_player = true
sprite_sheet = ExtResource("14_t7613")

