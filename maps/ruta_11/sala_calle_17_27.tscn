[node name="Huertano" type="Node2D" parent="Entities" unique_id=449480218 instance=ExtResource("5_blkor")]
position = Vector2(144, 208)
script = ExtResource("6_yf8vg")
display_name = "Huertano"
lines = PackedStringArray("En 2019 la gota fría dejó la Vega Baja bajo el agua. Mi casa tuvo un metro y medio de río dentro. La marca sigue en la pared.", "La alcachofa de la Vega se recoge de noviembre a abril. Del resto del año se encargan las riadas y la sequía, por turnos.")
turn_to_player = true
sprite_sheet = ExtResource("7_7vkjw")
initial_facing = 2

[node name="SuMadre" type="Node2D" parent="Entities" unique_id=1424767045 instance=ExtResource("5_blkor")]
position = Vector2(240, 112)
script = ExtResource("6_yf8vg")
display_name = "Su madre"
lines = PackedStringArray("Mi hijo habla de agua todo el día: si falta, si sobra, si llega. Aquí el tiempo no es conversación, es la cosecha.")
