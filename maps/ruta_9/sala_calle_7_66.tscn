display_name = "Guía del Palau"
lines = PackedStringArray("Aquí nació Francisco de Borja, duque de Gandía. Lo dejó todo para hacerse jesuita y acabó de santo. Lo normal en esta familia.", "Su bisabuelo fue el papa Alejandro VI. Los Borja de Roma tenían mala fama; los de Gandía, una fábrica de azúcar.")
