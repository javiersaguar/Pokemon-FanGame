initial_facing = 1

[node name="Guarda" type="Node2D" parent="Entities" unique_id=2009937425 instance=ExtResource("10_7jblf")]
position = Vector2(688, 400)
script = ExtResource("11_2lk1p")
lines = PackedStringArray("En los setenta quisieron llenar la Devesa de hoteles. La gente salió a la calle: «El Saler per al poble».", "Ganó el pinar. Es de las pocas veces que ha ganado un pinar.")
turn_to_player = true
sprite_sheet = ExtResource("13_mlsgd")

[node name="Cocinero" type="Node2D" parent="Entities" unique_id=97245452 instance=ExtResource("10_7jblf")]
position = Vector2(752, 880)
script = ExtResource("11_2lk1p")
lines = PackedStringArray("La paella lleva pollo, conejo, garrofó, bajoqueta y caracoles si hay.", "Al que le eche guisantes, que no vuelva. Y al del chorizo, que no salga de su casa.")
turn_to_player = true
sprite_sheet = ExtResource("13_mlsgd")

[node name="Llauradora" type="Node2D" parent="Entities" unique_id=1103970114 instance=ExtResource("10_7jblf")]
position = Vector2(624, 1296)
script = ExtResource("11_2lk1p")
lines = PackedStringArray("¡Naranjas a un euro el kilo! En el súper están a tres y vienen de la otra punta del mundo.", "A mí me las pagan a quince céntimos. Haz tú la cuenta, que yo ya la he hecho llorando.")
turn_to_player = true
sprite_sheet = ExtResource("14_dkgbb")

