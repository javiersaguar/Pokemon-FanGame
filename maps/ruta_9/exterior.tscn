script = ExtResource("6_gvuy1")
lines = PackedStringArray("RUTA 9 · LA ALBUFERA Y GANDÍA", "↑ Valencia   ↓ Gandía. Devesa del Saler: prohibido hacer fuego. Y paella, que también es fuego.")
show_sprite = false

[node name="CartelAlbufera" type="Node2D" parent="Entities" unique_id=1049197066 instance=ExtResource("5_e6l1n")]
position = Vector2(784, 528)
script = ExtResource("6_gvuy1")
lines = PackedStringArray("PARC NATURAL DE L\'ALBUFERA.", "El lago más grande de España. Aquí nació la paella. La de chorizo nació en otra parte, y que allí se quede.")
show_sprite = false

[node name="CartelBarcas" type="Node2D" parent="Entities" unique_id=1751601119 instance=ExtResource("5_e6l1n")]
position = Vector2(464, 1104)
script = ExtResource("6_gvuy1")
lines = PackedStringArray("PASEOS EN BARCA AL ATARDECER · El Palmar.", "Se paga en efectivo o con tarjeta. Con mascarillas, no: el último lote que nos colaron aún está en el almacén.")
show_sprite = false

[node name="CartelArroceria" type="Node2D" parent="Entities" unique_id=606000626 instance=ExtResource("5_e6l1n")]
position = Vector2(784, 1104)
script = ExtResource("6_gvuy1")
lines = PackedStringArray("ARROCERÍA · All i pebre y paella.", "Paella para dos: mínimo dos personas. Paella para uno: eso es un arroz y aquí no lo servimos.")
show_sprite = false

[node name="CartelCullera" type="Node2D" parent="Entities" unique_id=1513253761 instance=ExtResource("5_e6l1n")]
position = Vector2(528, 1360)
script = ExtResource("6_gvuy1")
lines = PackedStringArray("CULLERA.", "Arriba, el castillo y la Virgen. Abajo, las torres de pisos de veraneo. Cada una vigila lo suyo.")
show_sprite = false

[node name="CartelCastell" type="Node2D" parent="Entities" unique_id=1656800834 instance=ExtResource("5_e6l1n")]
position = Vector2(400, 1680)
script = ExtResource("6_gvuy1")
lines = PackedStringArray("CASTELL DE CULLERA.", "Desde aquí arriba se ven el Júcar, los arrozales y el mar. Y las letras blancas de CULLERA, por si te pierdes.")
show_sprite = false

[node name="CartelHeladeria" type="Node2D" parent="Entities" unique_id=1074720943 instance=ExtResource("5_e6l1n")]
position = Vector2(1104, 2416)
