[node name="Barquero" type="Node2D" parent="Entities" unique_id=495032974 instance=ExtResource("10_7jblf")]
position = Vector2(464, 976)
script = ExtResource("11_2lk1p")
lines = PackedStringArray("Mi abuelo pescaba anguilas en este lago. Mi padre, también. Yo paseo a turistas: pican más.", "Al atardecer el lago se pone rojo. Como la cara de los turistas sin crema.")
