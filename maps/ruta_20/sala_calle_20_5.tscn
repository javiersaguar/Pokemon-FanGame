position = Vector2(240, 80)
script = ExtResource("6_bi8r8")
display_name = "Guardés del santuario"
lines = PackedStringArray("Cuenta la leyenda que el caballero Teodosio de Goñi pasó años aquí atado con cadenas, de penitencia, y que un dragón le salió al paso.", "San Miguel bajó del cielo y mató al dragón. Las cadenas siguen colgadas en la pared, por si alguien no se lo cree.")
