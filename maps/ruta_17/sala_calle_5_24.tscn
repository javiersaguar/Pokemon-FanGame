[node name="Labrador" type="Node2D" parent="Entities" unique_id=220455418 instance=ExtResource("5_x8smb")]
position = Vector2(80, 176)
script = ExtResource("6_tq5wm")
display_name = "Labrador"
lines = PackedStringArray("Vacas, maíz, patatas y unos grelos. En el hórreo guardo el maíz; en la bodega, el vino; y en el banco, nada.", "Mis hijos se fueron a Barcelona. Vienen en agosto y en la matanza. A las vacas no las echan de menos; a mí, eso dicen.")
