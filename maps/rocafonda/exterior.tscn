[node name="AbuelaLamine" type="Node2D" parent="Entities" unique_id=735433918 instance=ExtResource("7_pui8u")]
position = Vector2(592, 624)
script = ExtResource("8_xa1hf")
display_name = "Abuela de Lamine"
lines = PackedStringArray("Mi nieto ya juega en el Barça y en la selección, pero para mí sigue siendo el niño que rompía los cristales con el balón.", "Se ha comprado esa casa tan grande, pero viene a comer aquí. Donde está la abuela, está la comida.", "¿Has comido? Siéntate, que hay arroz para todo el barrio.")
turn_to_player = true
sprite_sheet = ExtResource("12_080f4")

[node name="Vecino" type="Node2D" parent="Entities" unique_id=981378448 instance=ExtResource("7_pui8u")]
position = Vector2(272, 720)
script = ExtResource("8_xa1hf")
lines = PackedStringArray("Rocafonda es un barrio humilde. Cuando ese chaval marcó en la Eurocopa, aquí se oyó más que en el estadio.", "La mansión apareció de un día para otro. Antes era un descampado. Ahora es un descampado con verja.")
turn_to_player = true
sprite_sheet = ExtResource("13_y2oem")
initial_facing = 3

