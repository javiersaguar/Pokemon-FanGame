[node name="Guia" type="Node2D" parent="Entities" unique_id=2065188867 instance=ExtResource("5_8yhxk")]
position = Vector2(272, 240)
script = ExtResource("6_xqknp")
display_name = "Guía"
lines = PackedStringArray("La basílica está excavada en la roca del monte. Se construyó entre 1940 y 1958, también con trabajo de presos políticos.", "Desde 2022 el lugar se llama otra vez Valle de Cuelgamuros. Los restos del dictador salieron en 2019; los de Primo de Rivera, en 2023.")
