sprite_sheet = ExtResource("7_lo1r4")
initial_facing = 1

[node name="Forense" type="Node2D" parent="Entities" unique_id=208785418 instance=ExtResource("5_8yhxk")]
position = Vector2(112, 208)
script = ExtResource("6_xqknp")
display_name = "Forense"
lines = PackedStringArray("En las criptas hay más de treinta mil personas de los dos bandos. A muchas las trajeron sin avisar a sus familias.", "Trabajamos caja por caja para identificarlas por su ADN. Cada nombre que sale es una familia que por fin puede enterrar a los suyos.")
turn_to_player = true
sprite_sheet = ExtResource("8_pfsx0")

[node name="Nieta" type="Node2D" parent="Entities" unique_id=1736709314 instance=ExtResource("5_8yhxk")]
