[node name="Pastelera" type="Node2D" parent="Entities" unique_id=1947395602 instance=ExtResource("10_3akkt")]
position = Vector2(656, 720)
script = ExtResource("11_gx84q")
lines = PackedStringArray("Los encierros de San Fermín se corren con periódico enrollado y pañuelo rojo. El periódico es para dar a los toros. No lo hagas.", "El resto del año, Pamplona es tranquilísima. Demasiado. Por eso guardamos energía para julio.")
turn_to_player = true
sprite_sheet = ExtResource("12_7pkqo")

[node name="Navarro" type="Node2D" parent="Entities" unique_id=679872426 instance=ExtResource("10_3akkt")]
position = Vector2(1040, 784)
script = ExtResource("11_gx84q")
lines = PackedStringArray("Fermín, Fermina, Fermintxu. Aquí en julio nos llamamos todos igual.", "¿Del Osasuna o de qué? Bueno, eres de fuera. Se te perdona.")
turn_to_player = true
sprite_sheet = ExtResource("13_40ilr")

