[node name="CartelPortal" type="Node2D" parent="Entities" unique_id=940352091 instance=ExtResource("5_omddm")]
position = Vector2(1136, 304)
script = ExtResource("6_bek2e")
lines = PackedStringArray("PORTAL DE FRANCIA.", "Por aquí entran los peregrinos del Camino. Y los franceses, pero esos vienen en coche.")
show_sprite = false

[node name="CartelAyuntamiento" type="Node2D" parent="Entities" unique_id=1776207482 instance=ExtResource("5_omddm")]
position = Vector2(1488, 592)
script = ExtResource("6_bek2e")
lines = PackedStringArray("AYUNTAMIENTO.", "Del balcón sale el chupinazo el 6 de julio a mediodía. «¡Pamploneses, viva San Fermín!» Y nueve días sin dormir.")
show_sprite = false

[node name="CartelCastillo" type="Node2D" parent="Entities" unique_id=1411198677 instance=ExtResource("5_omddm")]
position = Vector2(912, 912)
script = ExtResource("6_bek2e")
lines = PackedStringArray("PLAZA DEL CASTILLO.", "El cuarto de estar de Pamplona. El Café Iruña es de 1888; Hemingway se sentaba aquí. Pagaba poco, decía más.")
show_sprite = false

[node name="CartelEstafeta" type="Node2D" parent="Entities" unique_id=41760186 instance=ExtResource("5_omddm")]
position = Vector2(1168, 1072)
script = ExtResource("6_bek2e")
lines = PackedStringArray("CALLE ESTAFETA.", "Por aquí corre el encierro: 875 metros, unos tres minutos y medio. Corre tú, que los Tauros no esperan.")
show_sprite = false

[node name="CartelToros" type="Node2D" parent="Entities" unique_id=109007532 instance=ExtResource("5_omddm")]
position = Vector2(1776, 1456)
script = ExtResource("6_bek2e")
lines = PackedStringArray("PLAZA DE TOROS.", "Final del encierro. Fuera del 7 al 14 de julio, conciertos y bodas. Y algún encierro de Tauros, si preguntas.")
show_sprite = false

[node name="CartelCiudadela" type="Node2D" parent="Entities" unique_id=828663283 instance=ExtResource("5_omddm")]
position = Vector2(688, 1328)
script = ExtResource("6_bek2e")
lines = PackedStringArray("LA CIUDADELA.", "Fortaleza renacentista con forma de estrella. Hoy es un parque; las murallas solo protegen del viento.")
show_sprite = false

[node name="CartelSur" type="Node2D" parent="Entities" unique_id=1458462860 instance=ExtResource("5_omddm")]
position = Vector2(848, 1712)
