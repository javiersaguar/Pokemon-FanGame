position = Vector2(272, 1232)
script = ExtResource("11_5t6nf")
lines = PackedStringArray("Aquí a los del barrio pesquero nos llaman pejinos. A los del centro, de otra manera, pero no lo digo.", "Las rabas son calamar rebozado en tiras. Si te lo ponen en anillas, estás en Madrid.")
turn_to_player = true
sprite_sheet = ExtResource("12_msk1j")

[node name="Banista" type="Node2D" parent="Entities" unique_id=639139540 instance=ExtResource("10_vs4a1")]
position = Vector2(1296, 208)
script = ExtResource("11_5t6nf")
lines = PackedStringArray("El Sardinero tiene dos playas, la Primera y la Segunda. Los nombres no costaron mucho.", "El agua está a dieciocho grados. En agosto. Ven en agosto.")
turn_to_player = true
sprite_sheet = ExtResource("13_yotcu")

[node name="Vecino" type="Node2D" parent="Entities" unique_id=820533815 instance=ExtResource("10_vs4a1")]
position = Vector2(784, 688)
script = ExtResource("11_5t6nf")
lines = PackedStringArray("Santander es la ciudad más elegante del norte. Eso lo dicen en Santander.", "Cuando sopla el viento sur, todo el mundo se vuelve loco. Hoy no sopla. Creo.")
turn_to_player = true
sprite_sheet = ExtResource("14_nqduj")

