[node name="CartelCatedral" type="Node2D" parent="Entities" unique_id=91797895 instance=ExtResource("5_5er6r")]
position = Vector2(240, 624)
script = ExtResource("6_kf2pj")
lines = PackedStringArray("CATEDRAL DE SANTANDER.", "Del siglo XII, con el claustro gótico. Sobrevivió al incendio de 1941, que se llevó medio centro.")
show_sprite = false

[node name="CartelMercado" type="Node2D" parent="Entities" unique_id=919192962 instance=ExtResource("5_5er6r")]
position = Vector2(1136, 624)
script = ExtResource("6_kf2pj")
lines = PackedStringArray("MERCADO DE LA ESPERANZA.", "Hierro del siglo XIX y pescado de esta mañana. Las anchoas, de Santoña.")
show_sprite = false

[node name="CartelPorticada" type="Node2D" parent="Entities" unique_id=834223161 instance=ExtResource("5_5er6r")]
position = Vector2(432, 976)
script = ExtResource("6_kf2pj")
lines = PackedStringArray("PLAZA PORTICADA.", "Se levantó después del incendio. Debajo hay un refugio de la guerra y un trozo de muralla medieval.")
show_sprite = false

[node name="CartelBotin" type="Node2D" parent="Entities" unique_id=595591971 instance=ExtResource("5_5er6r")]
position = Vector2(1008, 1168)
script = ExtResource("6_kf2pj")
lines = PackedStringArray("CENTRO BOTÍN · RENZO PIANO.", "Arte sobre la bahía, forrado con 270.000 piezas de cerámica. Lo pagó un banco. Lo has pagado tú, con las comisiones.")
show_sprite = false

[node name="CartelPuerto" type="Node2D" parent="Entities" unique_id=894990840 instance=ExtResource("5_5er6r")]
position = Vector2(80, 1232)
script = ExtResource("6_kf2pj")
lines = PackedStringArray("PUERTOCHICO · FERRY A INGLATERRA.", "El ferry a Portsmouth sale de la estación marítima. Tu aventura sigue por tierra.")
show_sprite = false

[node name="CartelCasino" type="Node2D" parent="Entities" unique_id=1188107507 instance=ExtResource("5_5er6r")]
