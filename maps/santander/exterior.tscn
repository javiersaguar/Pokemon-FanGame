script = ExtResource("6_kf2pj")
lines = PackedStringArray("PALACIO DE LA MAGDALENA.", "Lo pagó la ciudad para regalárselo al rey en 1912. El rey veraneaba gratis; la ciudad sigue pagando el mantenimiento.")
show_sprite = false

[node name="CartelFocas" type="Node2D" parent="Entities" unique_id=420314112 instance=ExtResource("5_5er6r")]
