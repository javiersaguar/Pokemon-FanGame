script = ExtResource("6_5q8dg")
display_name = "Vendedora de croquetas"
lines = PackedStringArray("Croquetas de jamón, de bacalao, de boletus y de algo que me pidió un influencer: de gin-tonic.", "Mi abuela las hacía con las sobras. Ahora las sobras cuestan tres euros la unidad.")
