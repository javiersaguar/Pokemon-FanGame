display_name = "Vendedor de ostras"
lines = PackedStringArray("Una ostra: seis euros. Con limón: siete. Con la sonrisa del vendedor: no está a la venta.", "Aquí se paga precio de turista. Los de Madrid también, pero lo llaman «experiencia gastronómica».")
