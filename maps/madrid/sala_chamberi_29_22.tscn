display_name = "Portero de la finca"
lines = PackedStringArray("Esta finca es de 1905. Tiene ascensor de madera, escalera de mármol y un fondo de inversión en el tercero.", "En la plaza de Olavide se toma el vermú a las doce. Yo lo tomo a las doce y diez, cuando cierro la portería.")
