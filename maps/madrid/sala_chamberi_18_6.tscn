initial_facing = 3

[node name="Ella" type="Node2D" parent="Entities" unique_id=1630355976 instance=ExtResource("5_mjxnv")]
position = Vector2(112, 112)
script = ExtResource("6_qukap")
display_name = "Ella"
lines = PackedStringArray("Dile a ese señor que deje de usar mi sartén. Sí, el señor de la tele: mi marido.", "Hemos puesto cinta en el suelo para dividir el salón. Su mitad tiene la tele; la mía, la calefacción.")
turn_to_player = true
sprite_sheet = ExtResource("7_35duh")
initial_facing = 3

