position = Vector2(48, 112)
script = ExtResource("6_qukap")
display_name = "Él"
lines = PackedStringArray("No nos hablamos desde el martes. Discutimos si la tortilla lleva cebolla y ya no hubo vuelta atrás.", "Seguimos viviendo juntos porque nadie puede pagar un piso solo. El amor se acabó; el contrato de alquiler, no.")
