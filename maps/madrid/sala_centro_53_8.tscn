display_name = "Opositor de cuarto año"
lines = PackedStringArray("Oposito a notarías desde 2019. Ya me sé el Código Civil y la cara de todos los camareros de Sol.", "Mi madre le dice a todo el mundo que estoy «sacando la plaza». La plaza es la de Callao, que la cruzo todos los días.")
