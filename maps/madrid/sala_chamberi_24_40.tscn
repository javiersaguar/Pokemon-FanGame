[node name="AficionadoALosTrenes" type="Node2D" parent="Entities" unique_id=602767304 instance=ExtResource("5_ki6jm")]
position = Vector2(80, 208)
script = ExtResource("6_5gkgu")
display_name = "Aficionado a los trenes"
lines = PackedStringArray("Me sé de memoria los horarios de 1919. Los de ahora no, porque cambian cada vez que se avería algo.", "Los anuncios de los azulejos son de antes de la guerra. Uno anuncia un jarabe para todo. Ojalá existiera.")
turn_to_player = true
