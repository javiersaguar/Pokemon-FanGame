display_name = "Guía del Andén 0"
lines = PackedStringArray("Esta estación se cerró en 1966. Los trenes pasan sin parar, como los sueldos por la cuenta.", "De noche se ven Pokémon fantasma en los azulejos. Son los únicos viajeros que no se quejan del aire acondicionado.")
