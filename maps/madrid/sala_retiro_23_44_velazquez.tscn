script = ExtResource("6_ky8do")
display_name = "Vigilante de sala"
lines = PackedStringArray("Por favor, no se acerque tanto al cuadro. Ese perro lleva ahí desde 1656 y no muerde.", "Llevo veinte años mirando Las Meninas. Ahora las veo hasta en la sopa del comedor de personal.")
turn_to_player = true
