[node name="ImitadorDeLasMeninas" type="Node2D" parent="Entities" unique_id=2049944519 instance=ExtResource("5_4mf4o")]
position = Vector2(48, 112)
script = ExtResource("6_ky8do")
display_name = "Imitador de Las Meninas"
lines = PackedStringArray("Me pongo delante del cuadro vestida de infanta y la gente me deja monedas. Velázquez me mira mal desde el lienzo.", "¿Sabes que en el cuadro sale el propio Velázquez pintando? Fue el primer selfi de la historia.")
