position = Vector2(144, 240)
script = ExtResource("6_ctbar")
display_name = "Ujier"
lines = PackedStringArray("En esta antesala se esperan los diputados antes de votar. Algunos votan sin saber qué; eso no es cosa mía.", "Los leones de la puerta se llaman Daoíz y Velarde. Son los únicos de esta casa que no cambian de opinión.")
