script = ExtResource("6_ctbar")
display_name = "Asesor parlamentario"
lines = PackedStringArray("Le escribo los discursos a un diputado. Él los lee como si fueran la lista de la compra.", "Hoy hay pleno. Habrá insultos, aplausos y un señor que se quedará dormido en el escaño de siempre.")
