[node name="Lotera" type="Node2D" parent="Entities" unique_id=928137030 instance=ExtResource("5_mr4w2")]
position = Vector2(112, 112)
script = ExtResource("6_qaefc")
display_name = "Lotera"
lines = PackedStringArray("La cola de diciembre empieza en agosto. El que la guarda cobra por hora, como un aparcacoches.", "Aquí ha tocado el Gordo once veces. A mí, ninguna: los loteros solo vemos pasar la suerte.")
