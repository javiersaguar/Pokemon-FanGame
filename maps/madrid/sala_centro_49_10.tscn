[node name="SenorDeLaCola" type="Node2D" parent="Entities" unique_id=1089600962 instance=ExtResource("5_mr4w2")]
position = Vector2(144, 208)
script = ExtResource("6_qaefc")
display_name = "Señor de la cola"
lines = PackedStringArray("Llevo cuatro horas en la cola. Si me toca, me compro un piso. Bueno, un trastero. Bueno, un décimo para el año que viene.", "No me toca nunca, pero vengo por el ambiente. Aquí hablas con gente que tampoco tiene esperanza.")
turn_to_player = true
