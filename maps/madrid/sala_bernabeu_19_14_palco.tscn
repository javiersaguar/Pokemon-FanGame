script = ExtResource("6_tnfq0")
display_name = "Camarero del palco"
lines = PackedStringArray("En el palco se ve el partido, se come jamón y se hacen negocios. El orden cambia según cómo vaya el marcador.", "Sirvo el mismo vino a ministros, empresarios y embajadores. Ninguno mira la etiqueta; todos miran quién está al lado.")
