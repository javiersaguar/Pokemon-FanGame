[node name="SuMujer" type="Node2D" parent="Entities" unique_id=1295318377 instance=ExtResource("5_yfbta")]
position = Vector2(48, 112)
script = ExtResource("6_ar1ba")
display_name = "Su mujer"
lines = PackedStringArray("Mi marido dice que dejó la política limpio. Lo único que se dejó limpio fue la caja fuerte.", "Los domingos vienen los nietos a escuchar sus batallas. Las mejores son las que no se pueden contar.")
turn_to_player = true
