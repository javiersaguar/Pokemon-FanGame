[node name="ConcejalJubilado" type="Node2D" parent="Entities" unique_id=959409110 instance=ExtResource("5_yfbta")]
position = Vector2(48, 176)
script = ExtResource("6_ar1ba")
display_name = "Concejal jubilado"
lines = PackedStringArray("Fui concejal de Urbanismo doce años. No pregunte de dónde salió el piso; salió de mucho trabajo y de un primo.", "Inauguré cuarenta rotondas. Ninguna llevaba a ninguna parte, pero quedaban preciosas.")
