[node name="NietoVegano" type="Node2D" parent="Entities" unique_id=282470215 instance=ExtResource("5_fr7aq")]
position = Vector2(208, 144)
script = ExtResource("6_bjjnv")
display_name = "Nieto vegano"
lines = PackedStringArray("Vengo a comer los domingos. La abuela me pone cocido «sin carne»: o sea, garbanzos con mucha fe.", "Le he explicado el veganismo tres veces. Ella dice que vale, y me pone chorizo aparte.")
turn_to_player = true
