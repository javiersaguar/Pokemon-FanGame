position = Vector2(48, 112)
script = ExtResource("6_bjjnv")
display_name = "Abuela de Malasaña"
lines = PackedStringArray("Este barrio antes se llamaba Maravillas. Luego vinieron los modernos y ahora se llama «zona de ocio».", "Abajo han abierto un local de tostadas a nueve euros. Yo hago tostadas a cero euros y nadie hace cola.")
