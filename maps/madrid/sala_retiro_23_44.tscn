[node name="TaquilleroDelPrado" type="Node2D" parent="Entities" unique_id=755919215 instance=ExtResource("5_3ya6w")]
position = Vector2(336, 240)
script = ExtResource("6_e7wsl")
display_name = "Taquillero del Prado"
lines = PackedStringArray("De seis a ocho la entrada es gratis. A las seis menos un minuto empieza la cola más culta de Madrid.", "Las salas de Velázquez y de Goya están al fondo. No se puede comer, ni tocar, ni hacer fotos con flash a Carlos IV.")
turn_to_player = true
sprite_sheet = ExtResource("7_7okqm")

[node name="GrupoDeJubilados" type="Node2D" parent="Entities" unique_id=980135358 instance=ExtResource("5_3ya6w")]
position = Vector2(336, 80)
script = ExtResource("6_e7wsl")
display_name = "Grupo de jubilados"
lines = PackedStringArray("Hemos venido de Cuenca en autobús a ver Las Meninas. El autobús sale en una hora; las veremos corriendo.", "Mi marido dice que el Bosco pintaba cosas muy raras. Le he dicho que es por la ropa que llevaba la gente.")
turn_to_player = true
