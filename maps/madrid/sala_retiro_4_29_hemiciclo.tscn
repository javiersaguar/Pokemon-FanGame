initial_facing = 3

[node name="Taquigrafa" type="Node2D" parent="Entities" unique_id=105743356 instance=ExtResource("5_03ahs")]
position = Vector2(432, 240)
script = ExtResource("6_06ivy")
display_name = "Taquígrafa"
lines = PackedStringArray("Lo apunto todo, hasta los insultos. Los insultos son lo más rápido que se dice aquí.", "En el Diario de Sesiones quedan para siempre. Algunos deberían leerse antes de hablar.")
