script = ExtResource("6_06ivy")
display_name = "Diputado de la última fila"
lines = PackedStringArray("Llevo tres legislaturas y nunca he hablado en la tribuna. Pero aplaudo como nadie: tengo las manos de acero.", "Voto lo que me dice el jefe de grupo con el dedo. Una vez me equivoqué de dedo y casi cae el Gobierno.")
