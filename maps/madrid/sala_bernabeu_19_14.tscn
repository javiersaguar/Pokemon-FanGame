[node name="GuiaDelTour" type="Node2D" parent="Entities" unique_id=639207620 instance=ExtResource("5_5ovdd")]
position = Vector2(48, 112)
script = ExtResource("6_7bqkm")
display_name = "Guía del tour"
lines = PackedStringArray("El tour pasa por la sala de trofeos, los vestuarios, el túnel y el palco. Por el césped no: el césped se mira y no se toca.", "Con la reforma, el estadio tiene techo que se cierra y un videomarcador que da la vuelta entera. Aparcamiento, el mismo de antes.")
turn_to_player = true
sprite_sheet = ExtResource("7_e50cv")
initial_facing = 1

[node name="SocioVeterano" type="Node2D" parent="Entities" unique_id=789384524 instance=ExtResource("5_5ovdd")]
position = Vector2(368, 176)
script = ExtResource("6_7bqkm")
display_name = "Socio veterano"
lines = PackedStringArray("Soy socio desde 1987. El abono pasará a mi hijo y luego a mi nieto. Es lo único de Chamartín que heredas sin hipoteca.")
