sprite_sheet = ExtResource("8_1flwk")
initial_facing = 1

[node name="VecinaDeEnfrente" type="Node2D" parent="Entities" unique_id=855252238 instance=ExtResource("5_5ovdd")]
position = Vector2(272, 208)
script = ExtResource("6_7bqkm")
display_name = "Vecina de enfrente"
lines = PackedStringArray("Vivo enfrente. Cuando hubo conciertos, el ruido nos llegaba al salón y los vecinos protestamos hasta que los pararon.", "El fútbol lo aguanto. Noventa minutos de gritos los domingos son más llevaderos que tres horas de bises.")
turn_to_player = true
