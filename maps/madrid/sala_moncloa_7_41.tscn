display_name = "Guía del templo"
lines = PackedStringArray("Este templo tiene más de dos mil años. Lo regaló Egipto en 1968 y Madrid lo puso al lado de un parque y lo dejó a la intemperie. Muy madrileño.", "Al atardecer viene media ciudad a hacer la misma foto. El templo ya tiene dos mil años y doscientos mil selfis.")
