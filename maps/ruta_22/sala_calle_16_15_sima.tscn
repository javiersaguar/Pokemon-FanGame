position = Vector2(144, 176)
script = ExtResource("6_k3q82")
display_name = "Paleontóloga"
lines = PackedStringArray("En la Sima de los Huesos han salido restos de una treintena de personas de hace unos 430.000 años. Es el mayor hallazgo de su época en el mundo.", "Se baja por una grieta estrecha, se excava tumbado y se sale con los huesos en cajitas. Esto es la réplica; la de verdad no la verías ni con linterna.")
